diff -ruN orig/debian/pve-manager.cron.d new/debian/pve-manager.cron.d
--- a/debian/pve-manager.cron.d	1969-12-31 16:00:00.000000000 -0800
+++ b/debian/pve-manager.cron.d	2026-10-28 13:31:06.852410048 -0700
@@ -0,0 +1,3 @@
+# Replaces the pve-daily-update timer unit (OnCalendar=*-*-* 1:00, RandomizedDelaySec=5h).
+# Runs the pve-daily-update ExecStart once a day at 01:00, with a random delay.
+0 1 * * * root sleep $(shuf -i 0-18000 -n 1); /usr/bin/pveupdate
diff -ruN orig/debian/rules new/debian/rules
--- a/debian/rules	2026-10-28 04:35:06.025500495 -0700
+++ b/debian/rules	2026-10-28 13:31:06.852873196 -0700
@@ -14,3 +14,18 @@
 
 override_dh_fixperms:
 	dh_fixperms -Xvar/log/pveproxy
+
+override_dh_installsystemd:
+
+override_dh_installinit:
+	dh_installinit -ppve-manager --name=pvedaemon
+	dh_installinit -ppve-manager --name=pveproxy
+	dh_installinit -ppve-manager --name=spiceproxy
+	dh_installinit -ppve-manager --name=pvestatd
+	dh_installinit -ppve-manager --name=pvescheduler
+# pvebanner, pvenetcommit and pve-guests are enabled but never started by upstream
+# on install (pvebanner/pvenetcommit are one-shot helpers, pve-guests needs a
+# running cluster); boot and the pve start sequence are the right times.
+	dh_installinit -ppve-manager --name=pvebanner --no-start
+	dh_installinit -ppve-manager --name=pvenetcommit --no-start
+	dh_installinit -ppve-manager --name=pve-guests --no-start
