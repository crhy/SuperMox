+++ b/debian/pve-manager.pvedaemon.init	2026-10-28 13:31:06.852479948 -0700
@@ -0,0 +1,59 @@
+#!/bin/sh
+### BEGIN INIT INFO
+# Provides:          pvedaemon
+# Required-Start:    corosync pve-cluster
+# Required-Stop:     corosync pve-cluster
+# Default-Start:     2 3 4 5
+# Default-Stop:      0 1 6
+# Short-Description: PVE API Daemon
+### END INIT INFO
+
+# Sysvinit service script translated from
+# upstream/pxvirt/packages/pve-manager/pve-manager/services/pvedaemon.service
+# ExecStart=/usr/bin/pvedaemon start  ExecStop=/usr/bin/pvedaemon stop
+# ExecReload=/usr/bin/pvedaemon restart  Type=forking  PIDFile=/run/pvedaemon.pid
+
+. /lib/lsb/init-functions
+
+DAEMON=/usr/bin/pvedaemon
+PIDFILE=/run/pvedaemon.pid
+NAME=pvedaemon
+
+case "$1" in
+  start)
+    log_begin_msg "Starting $NAME"
+    install -d -m 0750 -o root -g www-data /run/pve
+    "$DAEMON" start
+    log_end_msg $?
+    ;;
+  stop)
+    log_begin_msg "Stopping $NAME"
+    "$DAEMON" stop
+    log_end_msg $?
+    ;;
+  restart)
+    "$0" stop
+    "$0" start
+    ;;
+  reload|force-reload)
+    log_begin_msg "Reloading $NAME"
+    "$DAEMON" restart
+    log_end_msg $?
+    ;;
+  status)
+    start-stop-daemon --status --quiet --pidfile "$PIDFILE"
+    rc=$?
+    if [ "$rc" -eq 0 ]; then
+      log_success_msg "$NAME is running"
+    else
+      log_failure_msg "$NAME is not running"
+    fi
+    exit "$rc"
+    ;;
+  *)
+    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
+    exit 2
+    ;;
+esac
+
+exit 0
