+# True when this script runs inside a package build chroot rather than on a
+# booted node. The root a chroot sees is not the root of the running system,
+# so compare the dev:inode of / with that of /proc/1/root/.: on a booted
+# node pid 1 is init and the two are the same directory; in a chroot they
+# differ, and they also differ when the builder does not mount /proc at all
+# (stat then prints nothing), which is the safe answer. debianutils' ischroot
+# is not used: it reports an *interactive* chroot, and dpkg runs our scripts
+# non-interactively on a real node too.
+# A build chroot has never booted, so `hostname` and `hostname -I` answer for
+# the machine compiling the package, not for any node the image runs on.
+in_build_chroot() {
+  supermox_root="$(stat -c '%d:%i' / 2>/dev/null)"
+  supermox_init_root="$(stat -c '%d:%i' /proc/1/root/. 2>/dev/null)"
+  test -n "$supermox_init_root" && test "$supermox_root" = "$supermox_init_root" && return 1
+  return 0
+}
