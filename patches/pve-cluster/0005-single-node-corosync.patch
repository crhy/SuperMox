diff -ruN orig/debian/pve-cluster.postinst new/debian/pve-cluster.postinst
--- a/debian/pve-cluster.postinst	2026-10-28 13:16:11.577284141 -0700
+++ b/debian/pve-cluster.postinst	2026-10-28 21:12:24.284200847 -0700
@@ -28,8 +28,53 @@
   fi
 }
 
+setup_single_node_cluster() {
+  # pmxcfs runs in normal (corosync) mode. It resolves the local node name
+  # to a non-loopback IP and needs a matching nodelist entry in
+  # /etc/corosync/corosync.conf. The corosync package ships a placeholder
+  # (name: node1, ring0_addr: 127.0.0.1) which is unusable for a single node,
+  # so on first install we replace it with a correct single-node config and
+  # make the hostname resolvable via /etc/hosts.
+  CONF="/etc/corosync/corosync.conf"
+  # never clobber a real (multi-node) cluster config
+  if test -f "$CONF" && ! grep -q "name: node1" "$CONF"; then
+    return 0
+  fi
+  HOSTN="$(hostname)"
+  IP="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -vE '^(127\.|::1|fe80:|fec0:|fd[0-9]|0:)' | head -n1)"
+  if test -z "$IP"; then
+    echo "pve-cluster: no non-loopback IP for '$HOSTN'; leaving corosync.conf unchanged" >&2
+    return 0
+  fi
+  if ! grep -qE "[[:space:]]${HOSTN}\$" /etc/hosts; then
+    echo "$IP $HOSTN" >> /etc/hosts
+  fi
+  cat > "$CONF" <<EOF
+# generated by pve-cluster for single-node SuperMox
+totem {
+    version: 2
+    cluster_name: supermox
+    config_version: 1
+    crypto_cipher: none
+    crypto_hash: none
+}
+nodelist {
+    node {
+        name: $HOSTN
+        nodeid: 1
+        ring0_addr: $IP
+    }
+}
+EOF
+}
+
 case "$1" in
   configure)
+    # first install: set up a working single-node corosync.conf
+    if test -z "$2"; then
+      setup_single_node_cluster
+    fi
+
     # TODO: remove with PVE 10+
     if dpkg --compare-versions "$2" 'lt' '9.0.1'; then
       remove_fabrics_directory
