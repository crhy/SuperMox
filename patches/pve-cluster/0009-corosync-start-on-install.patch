+  # and (re)start corosync so pmxcfs can reach quorum when #DEBHELPER#
+  # starts the pve-cluster service below.
+  mkdir -p /var/log/corosync
+  invoke-rc.d corosync restart >/dev/null 2>&1 || invoke-rc.d corosync start >/dev/null 2>&1 || true
 }
 
