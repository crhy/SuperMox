diff -ruN orig/debian/postinst new/debian/postinst
--- a/debian/postinst	2026-10-28 04:35:21.387824622 -0700
+++ b/debian/postinst	2026-10-28 08:27:54.046464779 -0700
@@ -6,14 +6,12 @@
 
 case "$1" in
     configure)
-	# modeled after dh_systemd_start output
-	systemctl --system daemon-reload >/dev/null || true
 	if [ -n "$2" ]; then
-		_dh_action=try-reload-or-restart
+		_dh_action=force-reload
 	else
 		_dh_action=start
 	fi
-	deb-systemd-invoke $_dh_action pve-firewall.service >/dev/null || true
+	invoke-rc.d pve-firewall $_dh_action >/dev/null || true
     ;;
 
     abort-upgrade|abort-remove|abort-deconfigure)
diff -ruN orig/debian/rules new/debian/rules
--- a/debian/rules	2026-10-28 04:35:21.387824622 -0700
+++ b/debian/rules	2026-10-28 08:27:34.490583684 -0700
@@ -7,7 +7,7 @@
 	dh $@
 
 override_dh_installsystemd:
-	dh_installsystemd --name pvefw-logger pvefw-logger.service
-	dh_installsystemd --name pve-firewall --no-stop-on-upgrade --no-restart-after-upgrade pve-firewall.service
 
 override_dh_installinit:
+	dh_installinit -ppve-firewall --name=pvefw-logger
+	dh_installinit -ppve-firewall --name=pve-firewall --no-stop-on-upgrade --no-restart-after-upgrade
