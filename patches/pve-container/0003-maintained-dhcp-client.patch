+sub container_dhcp_client {
+    my ($vmid) = @_;
+
+    # Which DHCP client exists is decided by the container image, not by the
+    # node, so the probe runs inside the container's namespace. ISC's dhclient
+    # keeps priority (unchanged behaviour for images that ship it), then busybox
+    # udhcpc6/udhcpc.
+    my $found;
+    PVE::Tools::run_command(
+        [
+            'lxc-attach',
+            '-n',
+            $vmid,
+            '--',
+            '/bin/sh',
+            '-c',
+            'for c in /sbin/dhclient /usr/sbin/udhcpc6 /sbin/udhcpc6 /usr/sbin/udhcpc /sbin/udhcpc; do command -v "$c" >/dev/null 2>&1 && { command -v "$c"; exit 0; }; done; exit 1',
+        ],
+        outfunc => sub { $found = PVE::Tools::trim(shift) },
+        noerr => 1,
+    );
+
+    die "no DHCP client (dhclient, udhcpc6 or udhcpc) in container $vmid\n" if !defined($found) || !$found;
+    return $found;
+}
