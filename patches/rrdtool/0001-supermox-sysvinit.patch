--- a/debian/rules	2026-03-01 02:47:50.000000000 -0800
+++ b/debian/rules	2026-11-04 14:14:54.033353492 -0800
@@ -33,7 +33,7 @@
 	 --disable-python \
 	 --disable-ruby \
 	 --with-tcllib=/usr/lib/$(DEB_HOST_MULTIARCH)/tcl$(TCL_VERS) \
-	 --with-systemdsystemunitdir=/usr/lib/systemd/system \
+	 --with-systemdsystemunitdir=no \
 	 RRDDOCDIR=/usr/share/doc/rrdtool
 	dh_auto_configure --buildsystem=lua
 	dh_auto_configure --sourcedirectory=bindings/perl-shared
@@ -91,9 +91,17 @@
 override_dh_installdocs:
 	dh_installdocs -A CONTRIBUTORS NEWS
 
+# SuperMox: no systemd anywhere. configure.ac only generates
+# etc/rrdcached.service and etc/rrdcached.socket when
+# --with-systemdsystemunitdir is a real directory, so passing "no" stops the
+# unit files from being built at all; the empty override keeps debhelper from
+# installing and enabling them, and dh_installinit installs our
+# debian/rrdcached.rrdcached.init (copied in from init.d/rrdcached) as
+# /etc/init.d/rrdcached, enabled with update-rc.d.
 override_dh_installsystemd:
-	dh_installsystemd -prrdcached --restart-after-upgrade rrdcached.socket
-	dh_installsystemd -prrdcached --no-enable --no-start rrdcached.service
+
+override_dh_installinit:
+	dh_installinit -prrdcached --name=rrdcached
 
 override_dh_missing:
 	dh_missing -X.la -X.txt -X.pod
