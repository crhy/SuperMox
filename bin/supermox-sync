#!/usr/bin/python3
"""supermox-sync — the operator's handle on the home sync layer.

  supermox-sync reconcile [--home DIR] [--url URL]
      Read the cluster's signed membership list and make this node's
      Syncthing instance match it: one device per other member, one folder
      per member home, the built-in ignore list in each folder.  Idempotent;
      safe to run at every boot.

  supermox-sync status [--home DIR] [--url URL]
      What this instance has, and what it is doing.

  supermox-sync wait [--home DIR] [--url URL] [--folder ID] [--timeout S]
      Block until one folder reports idle with nothing left to transfer.
      This is what a script that acts on a synced home uses instead of sleeping.

  supermox-sync verify [--home DIR] [--url URL]
      Check the instance is configured the way the membership list says.

  supermox-sync shutdown [--home DIR] [--url URL]
      Ask the instance to exit.  The service starts it again.

  --state-dir picks the join state directory (default: $SUPERMOX_ETC).
  SUPERMOX_SYNC_HOME_ROOT overrides the root the member homes live under;
  it exists so a test can run two instances on one machine without touching
  /home, and it is refused if it is not an absolute path.

Nothing here talks to a peer directly: the membership list is the only
input, and the instance's own REST API is the only thing written to.

Syncthing 1.29.x speaks its REST API under /rest, authenticated with the
instance's API key, which lives in its config.xml.  There is no /api/v1
in this build, and the ignore list has no endpoint at all: it is the
shared folder's .stignore file.  See src/supermox/sync.py.

Part of supermox-ve (AGPLv3).
"""

import argparse
import http.client
import json
import logging
import os
import re
import socket
import sys
import urllib.parse

sys.path.insert(0, "/usr/lib/supermox")

from supermox import state, sync as sync_mod

DEFAULT_TIMEOUT = 10.0


class ApiError(Exception):
    pass


class HttpApi:
    """Syncthing's REST API, as 1.29.x serves it.

    Every request carries X-API-Key: the key is in the instance's config.xml,
    and without it every call answers 401.  A non-2xx answer becomes an
    ApiError carrying the body, because that body is where Syncthing says
    what a rejected write actually objected to.
    """

    def __init__(self, base_url: str, api_key: str,
                 timeout: float = DEFAULT_TIMEOUT):
        parts = urllib.parse.urlsplit(base_url.rstrip("/"))
        if parts.scheme not in ("http", "") or not parts.netloc:
            raise ApiError(
                "instance address must be http://host:port, got %r" % base_url)
        self.host, self.port = parts.hostname, parts.port
        self.api_key = api_key
        self.timeout = timeout

    def _request(self, method: str, path: str, obj=None):
        body = None
        headers = {"X-API-Key": self.api_key}
        if obj is not None:
            body = json.dumps(obj)
            headers["Content-Type"] = "application/json"
        conn = http.client.HTTPConnection(self.host, self.port,
                                          timeout=self.timeout)
        try:
            conn.request(method, path, body=body, headers=headers)
            resp = conn.getresponse()
            raw = resp.read().decode("utf-8", "replace")
        finally:
            conn.close()
        if resp.status >= 400:
            raise ApiError("%s %s: HTTP %d %s"
                           % (method, path, resp.status, raw.strip()))
        if not raw.strip():
            return None
        try:
            return json.loads(raw)
        except ValueError:
            return raw

    def get(self, path: str):
        return self._request("GET", path)

    def put(self, path: str, obj) -> bool:
        self._request("PUT", path, obj)
        return True

    def post(self, path: str, obj=None) -> bool:
        self._request("POST", path, obj or {})
        return True

    def read_stignore(self, folder_path: str):
        # Not an HTTP call: the ignore list is a file inside the shared folder.
        return sync_mod.read_stignore(folder_path)

    def write_stignore(self, folder_path: str, ignores) -> bool:
        return sync_mod.write_stignore(folder_path, ignores)


def config_text(home: str) -> str:
    """This instance's config.xml, as text.

    Read rather than parsed: the file is XML with a doctype and an
    <ignore> element that ElementTree's schema-free walk handles awkwardly,
    and only three scalars are wanted out of it.
    """
    path = os.path.join(home, "config.xml")
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError as exc:
        raise ApiError("%s: %s" % (path, exc.strerror)) from exc


def api_key(home: str) -> str:
    """The instance's API key, from inside its <gui> element.

    Syncthing generates it on first run and keeps it there; every REST call
    needs it.  An instance that has never started has none, which is why
    reconcile starts the daemon before asking it anything.
    """
    match = re.search(r"<gui[^>]*>.*?<apikey>([^<]+)</apikey>",
                      config_text(home), re.S)
    if not match:
        raise ApiError("%s/config.xml: no <apikey> in <gui>" % home)
    return match.group(1).strip()


def gui_address(home: str) -> str:
    """Where this instance listens, from its own <gui><address>.

    Read from the instance rather than assumed, so --home alone cannot end
    up talking to a different Syncthing that happens to own the default
    port.  The port is what the live test changes; this is how it follows.
    """
    match = re.search(r"<gui[^>]*>.*?<address>([^<]+)</address>",
                      config_text(home), re.S)
    addr = (match.group(1).strip() if match else "") or "127.0.0.1:8384"
    if "://" not in addr:
        addr = "http://" + addr
    return addr


def ensure_daemon(home: str) -> bool:
    """Start the instance if the service has not yet (re)started it.

    Reconcile needs the API, and the API only exists once syncthing serve
    is running.  The service unit is the thing that normally owns this
    process; starting it here is only for the operator's convenience, and
    the instance is left running rather than killed, since it is the one
    the service would start anyway.
    """
    import subprocess
    try:
        subprocess.run(["service", "supermox-sync", "start"],
                       check=True, capture_output=True)
        return True
    except (subprocess.CalledProcessError, OSError) as exc:
        logging.getLogger("supermox.sync").warning(
            "supermox-sync service not started: %s", exc)
        return False


def main(argv=None) -> int:
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    ap = argparse.ArgumentParser(prog="supermox-sync")
    ap.add_argument("--home", default=None,
                    help="Syncthing home (default: this node's sync home)")
    ap.add_argument("--url", default=None,
                    help="instance API base (default: from config.xml)")
    ap.add_argument("--node", default=None,
                    help="this node's name in the membership list")
    ap.add_argument("--state-dir", default=None,
                    help="join state directory (default: $SUPERMOX_ETC)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    for name in ("reconcile", "status", "verify", "shutdown"):
        sp = sub.add_parser(name)
        sp.add_argument("--home", default=argparse.SUPPRESS)
        sp.add_argument("--url", default=argparse.SUPPRESS)
        sp.add_argument("--node", default=argparse.SUPPRESS)

    wp = sub.add_parser("wait")
    for flag in ("--home", "--url", "--node"):
        wp.add_argument(flag, default=argparse.SUPPRESS)
    wp.add_argument("--folder", default=argparse.SUPPRESS)
    wp.add_argument("--timeout", default=argparse.SUPPRESS, type=float)

    args = ap.parse_args(argv)
    st = state.NodeState(args.state_dir or state.base_dir())
    st.load()
    node_name = args.node or resolve_node_name(st)
    if not node_name:
        print("cannot tell which member this node is; pass --node")
        return 1
    home = args.home or sync_mod.home_for(node_name)
    url = args.url or gui_address(home)
    api = HttpApi(url, api_key(home))

    if args.cmd == "reconcile":
        if api.get("%s/system/ping" % sync_mod.API_ROOT) is None:
            ensure_daemon(home)
        members = st.membership
        if not members:
            print("no membership list; nothing to configure")
            return 0
        summary = sync_mod.reconcile(
            members, node_name, None, api,
            record_device_id=lambda device_id:
                record_device_id(st, node_name, device_id))
        # Report only what changed, not the whole desired configuration:
        # summary["devices"]/["folders"] are the membership list's intent and
        # are always populated, so echoing them on every boot would make a
        # no-op reconcile look like it had written something.  `status` is
        # where the operator reads what is configured; reconcile says only
        # what it wrote and which members it could not configure (no id).
        for key in ("wrote", "skipped"):
            if summary[key]:
                print("%s: %s" % (key, ", ".join(summary[key])))
        return 0

    if args.cmd == "status":
        return cmd_status(api, node_name)

    if args.cmd == "verify":
        return cmd_verify(api, st, node_name)

    if args.cmd == "wait":
        folder = getattr(args, "folder", None) or sync_mod.folder_id(node_name)
        timeout = getattr(args, "timeout", None) or 60.0
        if sync_mod.wait_until_synced(api, folder, timeout):
            print("%s: idle, nothing to transfer" % folder)
            return 0
        print("%s: still transferring after %.0fs" % (folder, timeout))
        return 1

    if args.cmd == "shutdown":
        api.post("%s/system/shutdown" % sync_mod.API_ROOT)
        print("shutdown requested; the service will start it again")
        return 0

    return 2


def cmd_status(api, node_name: str) -> int:
    """What this instance has, and what it is doing.

    The device list is read back from the instance, not from the membership
    list: the point of ``status`` is to see what is actually configured,
    which is where a stale entry or a half-applied reconcile shows up.
    """
    my_id = sync_mod.local_device_id(api)
    devices = api.get("%s/config/devices" % sync_mod.API_ROOT) or []
    folders = api.get("%s/config/folders" % sync_mod.API_ROOT) or []
    print("node %s" % node_name)
    print("  devices:")
    for d in devices:
        if d.get("deviceID") == my_id:
            continue
        print("    %s (%s) %s" % (d.get("deviceID"), d.get("name"),
                                  ",".join(d.get("addresses") or [])))
    print("  folders:")
    for f in folders:
        state_body = sync_mod.folder_state(api, f["id"])
        conflicts = sync_mod.find_conflicts(f["path"])
        print("    %s -> %s" % (f["id"], f["path"]))
        print("      state %s, %d items to transfer, %d peers"
              % (state_body.get("state", "?"),
                 state_body.get("needTotalItems", 0),
                 max(len(f.get("devices") or []) - 1, 0)))
        if state_body.get("error"):
            print("      error: %s" % state_body["error"])
        if conflicts:
            print("      %d conflict copies (resolve by hand):"
                  % len(conflicts))
            for name in conflicts[:10]:
                print("        %s" % name)
    return 0


def resolve_node_name(st) -> str:
    """Which membership entry this node is.

    The entry whose Ed25519 public key matches this node's identity.  Without
    an identity there is nothing to match against, and guessing would put
    the wrong node's device id on the wrong member.
    """
    if st.identity is None or not st.membership:
        return None
    return st.my_name()


def record_device_id(st, node_name: str, device_id: str) -> bool:
    """Store this node's Syncthing device id in the signed membership list.

    Re-signing the list is what broadcasts the id to the other nodes, so a
    node that cannot sign (no identity) must say so rather than write a
    list nobody will trust.
    """
    if st.identity is None or st.find_member(node_name) is None:
        return False
    if st.find_member(node_name).get("syncthing_id") == device_id:
        return True
    st.set_syncthing_id(node_name, device_id)
    return True


def cmd_verify(api, st, node_name: str) -> int:
    """Compare the instance against the membership list, without writing.

    A mismatch here is what a boot-time reconcile would fix; printing it
    instead is for when the operator wants to look first.  The expectation
    is built from the membership list directly, so this command cannot
    write even by accident.
    """
    members = st.membership
    if not members:
        print("no membership list")
        return 1
    want_devices = sync_mod.desired_devices(members, node_name)
    want_folders = sync_mod.desired_folders(members,
                                            sync_mod.home_folders(members),
                                            node_name)
    my_id = sync_mod.local_device_id(api)
    ok = True

    have = api.get("%s/config/devices" % sync_mod.API_ROOT) or []
    have_ids = sorted(d["deviceID"] for d in have if d["deviceID"] != my_id)
    want_ids = sorted(d["deviceID"] for d in want_devices)
    if want_ids != have_ids:
        print("devices differ: expected %s, have %s"
              % (", ".join(want_ids) or "none",
                 ", ".join(have_ids) or "none"))
        ok = False
    for name in sorted(m["name"] for m in members if not m.get("syncthing_id")):
        print("no device id for member %s" % name)
        ok = False

    have_folders = api.get("%s/config/folders" % sync_mod.API_ROOT) or []
    want_ids = sorted(f["id"] for f in want_folders)
    have_ids = sorted(f["id"] for f in have_folders)
    if want_ids != have_ids:
        print("folders differ: expected %s, have %s"
              % (", ".join(want_ids), ", ".join(have_ids) or "none"))
        ok = False
    for folder in want_folders:
        if api.read_stignore(folder["path"]) != folder["ignore_list"]:
            print("%s: .stignore differs from the built-in list"
                  % folder["path"])
            ok = False
    print("verify: %s" % ("ok" if ok else "differences found"))
    return 0 if ok else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ApiError as exc:
        print("supermox-sync: %s" % exc, file=sys.stderr)
        sys.exit(1)
    except (ConnectionRefusedError, socket.timeout,
            http.client.HTTPException, OSError) as exc:
        print("supermox-sync: %s" % exc, file=sys.stderr)
        sys.exit(1)
