#!/usr/bin/env python3
"""supermox-sync: apply the membership list to Syncthing, and report on it.

reconcile  turns this node's signed membership list into the configuration
           of one user's Syncthing instance (devices over the overlay, the
           home folders, discovery/relays/NAT off, .stignore).
status     per folder: state, devices in sync, conflicts.

The instance is reached over its REST API on 127.0.0.1 only; the API key
comes from that instance's config.xml in its state directory.
"""

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request

try:
    from supermox import state as node_state
    from supermox import sync as sync_mod
except ImportError:  # repo checkout: bin/ sits next to src/
    sys.path.insert(
        0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
    from supermox import state as node_state
    from supermox import sync as sync_mod

USERS_FILE = "/etc/supermox/sync-users"
STATE_DIR = "/var/lib/supermox-sync"
BASE_PORT = 8384


def _users() -> list:
    """Users with a Syncthing instance on this node, in order."""
    try:
        with open(USERS_FILE, "r") as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    return [u for u in (line.split("#")[0].strip() for line in lines) if u]


def _instance(user: str) -> tuple:
    """(gui url, state dir) for one user's instance.

    init.d/supermox-sync starts the users in sync-users order on
    127.0.0.1:8384, :8385, ... and gives each its own state directory.
    """
    users = _users()
    if user and user in users:
        port = BASE_PORT + users.index(user)
    else:
        port = BASE_PORT
    state = os.environ.get("SUPERMOX_SYNC_STATE")
    if not state and user:
        state = os.path.join(STATE_DIR, user)
    if not state:
        state = os.path.expanduser("~/.config/syncthing")
    return "http://127.0.0.1:%d" % port, state


def _config_xml(state_dir: str) -> str:
    """Contents of the instance's config.xml, or '' if it is not there yet."""
    try:
        with open(os.path.join(state_dir, "config.xml"), "r") as f:
            return f.read()
    except OSError:
        return ""


def _xml_value(text: str, tag: str):
    """Value of one <Tag>...</Tag> element in config.xml, or None."""
    m = re.search(r"<%s>([^<]*)</%s>" % (tag, tag), text)
    return m.group(1) if m else None


class HttpApi:
    """Syncthing's REST API: get / put / post, JSON in and out."""

    def __init__(self, base: str, api_key: str):
        self.base = base.rstrip("/")
        self.api_key = api_key

    def _request(self, path: str, method: str, obj=None):
        url = "%s%s" % (self.base, path)
        data = None
        if obj is not None:
            data = json.dumps(obj).encode("utf-8")
        req = urllib.request.Request(
            url, data=data, method=method,
            headers={"Authorization": "Bearer %s" % self.api_key,
                     "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                body = resp.read().decode("utf-8")
        except urllib.error.HTTPError as exc:
            if exc.code == 404:
                return None
            raise RuntimeError("GET %s: HTTP %d" % (path, exc.code))
        except OSError as exc:
            raise RuntimeError("%s %s: %s" % (method, path, exc))
        if not body:
            return None
        try:
            return json.loads(body)
        except json.JSONDecodeError:
            return body

    def get(self, path: str):
        return self._request(path, "GET")

    def put(self, path: str, obj):
        return self._request(path, "PUT", obj)

    def post(self, path: str, obj):
        return self._request(path, "POST", obj)


def _target(args) -> tuple:
    """(gui url, state dir) for the instance the user asked for."""
    url, state = _instance(args.user)
    return args.url or url, args.state or state


def _api(args) -> HttpApi:
    """Build the API client for the instance the user asked for."""
    url, state = _target(args)
    key = _xml_value(_config_xml(state), "APIKey")
    if not key:
        print("no APIKey in %s/config.xml: no Syncthing instance running for"
              " user %s" % (state, args.user or "default"), file=sys.stderr)
        return None
    return HttpApi(url, key)


def cmd_reconcile(args) -> int:
    api = _api(args)
    if api is None:
        return 1
    st = node_state.NodeState()
    if not st.load():
        print("no cluster here: run supermox-join create first", file=sys.stderr)
        return 1
    local_node = st.my_name()

    # Enroll this node's own device id, so the other members get an entry
    # for it too (docs/shared-home.md: no "accept host" clicking anywhere).
    _url, state = _target(args)
    device_id = _xml_value(_config_xml(state), "DeviceID")
    if device_id:
        mine = [m for m in st.membership if m.get("name") == local_node]
        if mine and mine[0].get("syncthing_id") != device_id:
            st.set_syncthing_id(local_node, device_id)
            print("recorded device id %s for %s in the membership list; "
                  "broadcast the list so the other nodes learn it too"
                  % (device_id, local_node))
    else:
        print("no DeviceID in %s/config.xml: this node's own entry stays "
              "unlisted until syncthing has started once" % state)

    folders = sync_mod.home_folders(st.membership)
    summary = sync_mod.reconcile(st.membership, local_node, folders, api)
    print("devices: %s" % (", ".join(summary["devices"]) or "-"))
    print("folders: %s" % (", ".join(summary["folders"]) or "-"))
    if summary["skipped"]:
        print("skipped (no syncthing_id): %s" % ", ".join(summary["skipped"]))
    print("wrote: %s" % (", ".join(summary["wrote"]) or "nothing (already in sync)"))
    return 0


def cmd_status(args) -> int:
    api = _api(args)
    if api is None:
        return 1
    folders = api.get("%s/config/folders" % sync_mod.API_ROOT) or []
    status = api.get("%s/status/" % sync_mod.API_ROOT) or {}
    per_folder = status.get("folders") or {}
    peers = api.get("%s/peer-count" % sync_mod.API_ROOT)
    peer_count = peers if isinstance(peers, int) else 0

    if not folders:
        print("no folders configured")
        return 0
    for folder in folders:
        fid = folder.get("id", "?")
        info = per_folder.get(fid) or {}
        state = api.get("%s/state/%s" % (sync_mod.API_ROOT, fid))
        if isinstance(state, dict):
            state = state.get("state", "?")
        need_sync = bool(info.get("need_sync"))
        error = info.get("error") or ""
        shared = folder.get("share_devices") or []
        conflicts = _conflicts(folder.get("path") or "")
        print("%s (%s)" % (fid, folder.get("path", "?")))
        print("  state: %s%s" % (state or "?",
                                 ", needs sync" if need_sync else ", in sync"))
        print("  devices in sync: %d of %d connected (%d configured)"
              % (peer_count, peer_count, len(shared)))
        if error:
            print("  error: %s" % error)
        if conflicts:
            print("  conflicts: %d file(s) marked %s"
                  % (conflicts, sync_mod.CONFLICT_MARKER))
    return 0


def _conflicts(path: str) -> int:
    """Files under path whose name carries Syncthing's conflict marker."""
    if not path or not os.path.isdir(path):
        return 0
    count = 0
    for _root, _dirs, files in os.walk(path):
        for name in files:
            if sync_mod.CONFLICT_MARKER in name:
                count += 1
    return count


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="supermox-sync")
    ap.add_argument("--user", default=None,
                    help="user whose Syncthing instance to talk to "
                         "(default: the first in %s)" % USERS_FILE)
    ap.add_argument("--url", default=None, metavar="http://host:port")
    ap.add_argument("--state", default=None, metavar="DIR",
                    help="Syncthing state directory (holds config.xml)")
    sub = ap.add_subparsers(dest="command", required=True)

    p = sub.add_parser("reconcile", help="apply the membership list")
    p.set_defaults(func=cmd_reconcile)

    p = sub.add_parser("status", help="per-folder state, sync, conflicts")
    p.set_defaults(func=cmd_status)

    args = ap.parse_args(argv)
    try:
        return args.func(args)
    except RuntimeError as exc:
        print("supermox-sync: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
