#!/usr/bin/env python3
"""supermox-join: create a cluster, invite a node, join a cluster, approve.

Talks to the join daemon (src/supermox/joind.py) over TCP. Never prints
the cluster phrase except once, when create generates it, and does not
create the tunnel itself: init.d/supermox-wg brings it up on this host.
"""

import argparse
import json
import os
import platform
import sys
import time

try:
    from supermox import joind
    from supermox import identity as node_identity
    from supermox import invite as invite_mod
    from supermox import secret
    from supermox import state as node_state
    from supermox import corosync_cluster
except ImportError:  # repo checkout: bin/ sits next to src/
    sys.path.insert(
        0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
    from supermox import joind
    from supermox import identity as node_identity
    from supermox import invite as invite_mod
    from supermox import secret
    from supermox import state as node_state
    from supermox import corosync_cluster


def _arch() -> str:
    """Debian architecture name of this node (uname -m mapped)."""
    machine = platform.uname().machine
    names = {"x86_64": "amd64", "aarch64": "arm64", "i586": "amd64",
             "armv7l": "armhf", "armv8l": "arm64", "mips64": "riscv64"}
    return names.get(machine, machine)


def _caps() -> list:
    """Capability tiers, from supermox-node-caps --json when installed."""
    import subprocess
    try:
        out = subprocess.run(["supermox-node-caps", "--json"],
                             capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if out.returncode != 0:
        return []
    try:
        data = json.loads(out.stdout)
    except json.JSONDecodeError:
        return []
    return ["%s" % k for k, v in data.items()
            if v is True or v == "yes"]


def _state() -> node_state.NodeState:
    """Load this node's state, creating the base directory if needed."""
    st = node_state.NodeState()
    st.load()
    return st


def _identity(st: node_state.NodeState) -> dict:
    """This node's keypairs; generated and saved on first use."""
    if st.identity is None:
        st.identity = node_identity.new_identity()
        node_identity.save(st.identity, st.path("identity"))
    return st.identity


def _ensure_cluster(st) -> tuple:
    """Make corosync and pmxcfs see the cluster this node belongs to.

    The overlay address is waited for first (up to 15 s): ``wg up`` returns
    before the kernel has assigned the interface its address, and corosync
    dials the address at start instead of waiting for it, so writing the
    nodelist before the address exists just moves the failure into a
    corosync that exited with status 8 behind an init script that said 0.
    """
    ok, note = corosync_cluster.wait_for_overlay(st)
    if not ok:
        return False, note
    return corosync_cluster.init_cluster(st)


def cmd_create(args) -> int:
    st = _state()
    if st.derived is not None:
        print("this node already belongs to a cluster", file=sys.stderr)
        return 1
    # Validate the name before anything is generated or written: corosync
    # itself refuses a name with a leading or trailing dash, and a name it
    # would refuse is not worth creating a keypair and an overlay for.
    if not corosync_cluster.name_ok(args.name):
        print("not a valid cluster name: %r (letters, digits and internal "
              "dashes, at most 30 characters)" % (args.name,), file=sys.stderr)
        return 1
    phrase = secret.generate()
    endpoints = [args.endpoint] if args.endpoint else []
    wg_ep = None
    if args.endpoint:
        wg_ep = args.my_wg_endpoint or joind.wg_endpoint_for(args.endpoint)
    st.create_cluster(phrase, args.name, endpoints, _arch(), _caps(), wg_ep)
    # A cluster of one is still a cluster: write this node's wg0.conf and ask
    # init.d/supermox-wg to bring the overlay up, exactly like join and conf
    # do, so the first node is not left in a state where the cluster exists
    # but the tunnel only appears after someone thinks to run `conf`.
    path = joind.write_wg_conf(st)
    _apply_overlay("start")
    print("wrote %s" % path)
    # The phrase goes out before the corosync step, not at the end of the
    # command: it is shown once, never written anywhere, and a step that
    # can fail must not be able to swallow it.
    print("Cluster created. The 12 words below are the whole cluster secret.")
    print("They are shown once, are not written to any file and are not")
    print("backed up anywhere. Write them down off this machine, or use")
    print("the recovery QR (supermox-join invite --recovery-qr) later.")
    print()
    print(phrase)
    print()
    # The node has an identity, keys and a tunnel, and is still not a
    # cluster as far as corosync and pmxcfs are concerned until the
    # nodelist is written; see src/supermox/corosync_cluster.py.
    ok, msg = _ensure_cluster(st)
    if not ok:
        print("corosync cluster: FAILED: %s" % msg, file=sys.stderr)
        print("state, keys and overlay are in place; re-run this step with "
              "supermox-join cluster-init once the cause is fixed (it is "
              "idempotent)", file=sys.stderr)
        return 1
    print("corosync cluster: %s" % msg)
    return 0


def cmd_invite(args) -> int:
    st = _state()
    if st.derived is None:
        print("no cluster here: run supermox-join create first", file=sys.stderr)
        return 1
    inv = st.new_invite(ttl=args.ttl)
    uri = invite_mod.to_uri(inv)
    print(uri)
    print(invite_mod.render_text(uri))
    if args.png:
        invite_mod.render_png(uri, args.png)
        print("wrote %s" % args.png)
    return 0


def cmd_join(args) -> int:
    st = _state()
    if st.derived is not None and st.membership:
        for m in st.membership:
            if m["name"] == args.name:
                print("%s is already a member of this cluster" % args.name,
                      file=sys.stderr)
                return 1
    ident = _identity(st)
    caps = _caps() if args.caps is None else _split(args.caps)
    # This node's own endpoints: the join daemon (TCP 8743) and, separately,
    # its WireGuard endpoint (same host, UDP 51820) for the other members'
    # wg0.conf.
    my_ep = args.my_endpoint or args.endpoint
    wg_ep = args.my_wg_endpoint or joind.wg_endpoint_for(my_ep)
    if args.uri:
        invite = invite_mod.parse_uri(args.uri)
        ack = _run(joind.join_invite(args.endpoint, invite, ident,
                                     args.name, args.arch, caps, wg_ep))
        joind.apply_invite_ack(st, ack)
    else:
        if not args.words:
            print("join needs --words or --uri", file=sys.stderr)
            return 1
        secret.validate(args.words)
        derived = secret.derive(args.words)
        derived["entropy"] = secret.entropy(args.words)
        st.derived = derived
        ack = _run(joind.join_phrase(args.endpoint, derived, ident,
                                     args.name, args.arch, caps, wg_ep))
        joind.apply_join_ack(st, ack)
    path = joind.write_wg_conf(st)
    print("joined as %s; wrote %s" % (args.name, path))
    _apply_overlay("start")
    if args.my_endpoint:
        _run(joind.send_command(args.endpoint, {
            "t": "endpoints", "node": args.name,
            "endpoints": [args.my_endpoint],
            "wg_endpoint": wg_ep}))
    # A node with nothing running on it should not have to be told twice that
    # it may join the core, so join finishes the job by asking a member to
    # make it a core member. A node that has guests, or whose guests cannot
    # be counted, stays an edge node and is told why.
    count, err = _guests()
    if err is None and count == 0:
        if cmd_core(_core_args()) != 0:
            print("joined, but not a core member yet: run supermox-join core",
                  file=sys.stderr)
    elif err:
        print("staying an edge node: %s; run supermox-join core once that "
              "changes" % err, file=sys.stderr)
    else:
        print("staying an edge node: %d guest(s) on this node; run supermox-join "
              "core once they are moved off" % count, file=sys.stderr)
    return 0


def _core_args():
    """The argument namespace cmd_core needs when cmd_join calls it directly."""
    return argparse.Namespace(write_only=False)


def cmd_conf(args) -> int:
    st = _state()
    if st.derived is None:
        print("no cluster here: run supermox-join create first", file=sys.stderr)
        return 1
    path = joind.write_wg_conf(st)
    print("wrote %s" % path)
    _apply_overlay("start")
    # conf is also the recovery path for a create whose corosync step failed:
    # init_cluster is idempotent, so re-applying local config re-writes the
    # nodelist and re-checks quorum without touching keys or membership.
    ok, msg = _ensure_cluster(st)
    if not ok:
        print("corosync cluster: FAILED: %s" % msg, file=sys.stderr)
        return 1
    print("corosync cluster: %s" % msg)
    return 0


def cmd_cluster_init(args) -> int:
    """Bring an existing cluster's corosync config up to the state file.

    For a node whose overlay cluster already exists -- created before this
    step existed, or created with its corosync step failed -- this is the
    whole repair: no keys, no membership, no overlay is touched, only the
    nodelist corosync and pmxcfs need. It is idempotent, so it is also
    what ``conf`` runs after rewriting wg0.conf.
    """
    st = _state()
    if st.derived is None:
        print("no cluster here: run supermox-join create first", file=sys.stderr)
        return 1
    ok, msg = _ensure_cluster(st)
    if not ok:
        print("corosync cluster: FAILED: %s" % msg, file=sys.stderr)
        return 1
    print("corosync cluster: %s" % msg)
    return 0


def _corosync_dir() -> str:
    """Where this node's corosync config and key live.

    SUPERMOX_COROSYNC_DIR redirects the directory for tests and for a staging
    root; the default is the one corosync itself is built with, so nothing
    here has to know about distro layout.
    """
    return os.environ.get("SUPERMOX_COROSYNC_DIR", "/etc/corosync")


def _core_paths() -> tuple:
    """(corosync.conf, authkey, where the pre-join config is moved to).

    The third name is upstream's rollback: a node that fails half way through
    becoming a core member must still be able to boot its old single-node
    cluster, so the config it had before this command is kept, not overwritten
    in place.
    """
    d = _corosync_dir()
    return (os.path.join(d, "corosync.conf"),
            os.path.join(d, "authkey"),
            os.path.join(d, "corosync.conf.supermox-single"))


def _write_mode(path: str, data, mode: int) -> None:
    """Write one file atomically with its mode already set."""
    tmp = "%s.tmp" % path
    with open(tmp, "wb") as fh:
        fh.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def _write_core_files(authkey: bytes, conf_text: str) -> None:
    """Put the authkey on disk before the config that needs it.

    A corosync.conf naming peers this node has no key for is what makes
    corosync refuse to start, so the key goes first; and the authkey is
    corosync's shared secret, so it is never world-readable.
    """
    conf_path, auth_path, _single = _core_paths()
    _write_mode(auth_path, authkey, 0o400)
    _write_mode(conf_path, conf_text.encode("utf-8"), 0o644)


def _run_argv(argv: list) -> tuple:
    """Run one command, returning (rc, combined output)."""
    import subprocess
    try:
        proc = subprocess.run(argv, stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, text=True, timeout=600)
    except subprocess.TimeoutExpired:
        return 1, "command timed out after 600 s"
    except OSError as exc:
        return 1, "cannot run %s: %s" % (argv[0], exc)
    return proc.returncode, proc.stdout


def _run_dir() -> str:
    """Where data for upstream's PVE calls is staged.

    SUPERMOX_RUN_DIR redirects it for tests and for a staging root; the default
    is the tmpfs directory supermox owns, so a staged secret never has to sit
    on a persistent filesystem.
    """
    return os.environ.get("SUPERMOX_RUN_DIR", "/run/supermox")


def _stage_core_data(authkey: bytes, conf_text: str) -> tuple:
    """(corosync.conf, authkey) staged under the run directory, mode 0600.

    finish_join takes the config and the key as strings, and a command line
    is visible in ps to anyone on the machine, so neither goes in argv: they
    go in files only root can read, and are removed as soon as perl has read
    them.
    """
    d = _run_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    paths = (os.path.join(d, "core-join.conf"),
             os.path.join(d, "core-join.authkey"))
    _write_mode(paths[1], authkey, 0o600)
    _write_mode(paths[0], conf_text.encode("utf-8"), 0o600)
    return paths


def _unstage_core_data(paths: tuple) -> None:
    """Remove the staged config and key."""
    for path in paths:
        try:
            os.remove(path)
        except OSError:
            pass


def _guests() -> tuple:
    """(number of guests on this node, error or None).

    Upstream refuses to make a node that runs VMs or containers a core member
    (assert_joinable checks qm list and pct list), because a guest's disks,
    MAC addresses and backup jobs belong to one machine and a cluster has to
    decide which one. pmxcfs is the source of truth here, so pvesh is asked
    instead of parsing the qm and pct tables.
    """
    rc, out = _run_argv(["pvesh", "get", "/cluster/resources",
                         "--output-format", "json"])
    if rc != 0:
        return None, "pvesh get /cluster/resources failed (rc=%d)" % rc
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return None, "pvesh get /cluster/resources did not answer with json"
    if not isinstance(data, list):
        return None, "pvesh get /cluster/resources answered with %s" % (
            type(data).__name__)
    return sum(1 for e in data
               if isinstance(e, dict) and e.get("type") in ("vm", "lxc")), None


def cmd_core(args) -> int:
    """Make this node a corosync core member (docs/cluster-core-join.md §2).

    Ask a member's daemon for this cluster's corosync.conf and authkey
    (CORE_REQ -> CORE_ACK), then hand both to upstream's finish_join, which
    writes them, stops pve-cluster, backs up the pmxcfs database, starts
    corosync and pve-cluster, waits for quorum and regenerates the node
    certificate. Nothing here duplicates that, and nothing is written
    before a member has actually agreed.
    """
    st = _state()
    if st.derived is None or not st.membership:
        print("no cluster here: run supermox-join create first", file=sys.stderr)
        return 1
    if st.pending:
        print("%d join request(s) still awaiting approval: a cluster with "
              "edge nodes cannot hand out its corosync key"
              % len(st.pending), file=sys.stderr)
        return 1
    try:
        me = corosync_cluster.my_entry(st)
    except corosync_cluster.CorosyncError as exc:
        print("%s" % exc, file=sys.stderr)
        return 1
    count, err = _guests()
    if err:
        print("cannot tell whether this node has guests: %s; refusing to make a "
              "node a core member without knowing that" % err, file=sys.stderr)
        return 1
    if count:
        print("%d guest(s) on this node: only a node with no VMs or containers "
              "may become a core member; move them off first" % count,
              file=sys.stderr)
        return 1
    ident = _identity(st)
    ack = None
    answered_by = None
    asked = []
    for m in st.membership:
        if m["name"] == me["name"]:
            continue
        asked.append(m["name"])
        try:
            # Overlay addresses are IPv6: bracket them, or the endpoint
            # parser splits the address itself on its last colon.
            endpoint = joind.endpoint_for_addr(m["overlay_addr"])
            ack = _run(joind.core_join(endpoint, ident,
                                       me["name"], m["wg_pub"]))
        except joind.JoinError as exc:
            print("%s: %s" % (m["name"], exc), file=sys.stderr)
            continue
        answered_by = m["name"]
        break
    if ack is None:
        print("no member made this node a core member (asked: %s)"
              % ", ".join(asked), file=sys.stderr)
        return 1
    expected = corosync_cluster.cluster_name(st)
    if ack["cluster_name"] != expected:
        print("%s sent a config for cluster %r; this node belongs to %r"
              % (answered_by, ack["cluster_name"], expected), file=sys.stderr)
        return 1
    conf_path, auth_path, single_path = _core_paths()
    # Upstream's finish_join overwrites corosync.conf, so the config this
    # node had before becoming a core member is moved aside first: if the
    # rest of the join fails, that file plus a restart is what puts the
    # old single-node cluster back.
    had_conf = os.path.exists(conf_path)
    if had_conf:
        os.replace(conf_path, single_path)
    _write_core_files(ack["corosync_authkey"], ack["corosync_conf"])
    print("wrote %s (0400) and %s" % (auth_path, conf_path))
    if args.write_only:
        print("not a core member yet: re-run without --write-only to let "
              "upstream's finish_join start corosync and pve-cluster")
        return 0
    # finish_join takes the contents, not the paths, so they are staged as
    # 0600 files under the run directory and read from there rather than put
    # on the command line where ps would show the corosync key.
    staged = _stage_core_data(ack["corosync_authkey"], ack["corosync_conf"])
    try:
        rc, out = _run_argv([
            "perl", "-MPVE::Cluster::Setup", "-MPVE::Tools", "-e",
            "PVE::Cluster::Setup::finish_join($ARGV[0], "
            "PVE::Tools::file_get_contents($ARGV[1]), "
            "PVE::Tools::file_get_contents($ARGV[2]));",
            me["name"], staged[0], staged[1]])
    finally:
        _unstage_core_data(staged)
    print(out.rstrip())
    if rc != 0:
        print("finish_join failed (rc=%d)" % rc, file=sys.stderr)
        if had_conf:
            os.replace(single_path, conf_path)
            print("restored %s" % conf_path, file=sys.stderr)
        rc2, out2 = _run_argv([
            "perl", "-MPVE::SysvService", "-e",
            'PVE::SysvService::restart("corosync"); '
            'PVE::SysvService::restart("pve-cluster");'])
        print(out2.rstrip())
        if rc2 != 0:
            print("corosync and pve-cluster were not restarted (rc=%d): "
                  "this node is still an edge node, and its own cluster may "
                  "need a manual start" % rc2, file=sys.stderr)
        print("this node is still an edge node: re-run supermox-join core "
              "(or supermox-join cluster-init) to repair it", file=sys.stderr)
        return 1
    # finish_join rewrites both files through PVE::Tools::file_set_contents,
    # whose default mode is 0644; the authkey is corosync's shared secret,
    # so put the mode back.
    os.chmod(auth_path, 0o400)
    print("this node is a corosync core member of cluster %s" % expected)
    return 0


def cmd_pending(args) -> int:
    st = _state()
    if args.json:
        # One JSON array for the Manager: id, name, arch and how long the
        # request has been waiting. An empty array means "nothing pending", so
        # the Manager never has to parse prose.
        now = int(time.time())
        print(json.dumps([
            {"id": rid,
             "name": rec.get("name", "?"),
             "arch": rec.get("arch", "?"),
             "age_s": now - int(rec.get("time") or now)}
            for rid, rec in sorted(st.pending.items())], indent=2))
        return 0
    if not st.pending:
        print("no join requests waiting")
        return 0
    for rid, rec in sorted(st.pending.items()):
        print("%s  %s (%s) caps=%s invite=%s"
              % (rid, rec["name"], rec["arch"], ",".join(rec["caps"]),
                 rec["invite_id"]))
    return 0


def cmd_decide(args) -> int:
    st = _state()
    if args.request_id not in st.pending:
        print("%s is not a pending request" % args.request_id, file=sys.stderr)
        return 1
    reply = _run(joind.send_command(args.endpoint, {
        "t": args.command, "request_id": args.request_id}))
    if reply.get("t") != "resolved":
        print("daemon did not resolve %s: %s"
              % (args.request_id, reply.get("t", "?")), file=sys.stderr)
        return 1
    print("%s %s" % (args.command, args.request_id))
    return 0


def cmd_members(args) -> int:
    st = _state()
    if args.json:
        # One JSON array for the Manager. "core" is true exactly when this
        # member is in /etc/pve/corosync.conf's nodelist: a member listed there
        # runs corosync with this cluster's key, an overlay member does not.
        # An empty array means "this node has no cluster" (exit 0): the Manager
        # reads that as "offer Create cluster", not as an error.
        core_names = set(corosync_cluster.nodelist_names(
            corosync_cluster.PVE_COROSYNC_CONF))
        print(json.dumps([
            {"name": m["name"],
             "role": m.get("role", "edge"),
             "overlay_addr": m.get("overlay_addr", ""),
             "arch": m.get("arch", "?"),
             "caps": list(m.get("caps") or []),
             "core": m["name"] in core_names}
            for m in st.membership], indent=2))
        return 0
    if not st.membership:
        print("no members: this node has no cluster")
        return 1
    for m in st.membership:
        print("%-16s %-8s %-39s %s wg=%s"
              % (m["name"], m["arch"], m["overlay_addr"],
                 ",".join(m.get("endpoints", [])) or "-",
                 m.get("wg_endpoint") or "-"))
    return 0


def _split(text: str) -> list:
    return [p for p in text.split(",") if p]


def _run(coro):
    """Run one coroutine to completion (the CLI is synchronous)."""
    import asyncio
    return asyncio.run(coro)


def _apply_overlay(action: str) -> None:
    """Ask init.d/supermox-wg to apply the config just written.

    Reported, never fatal: the join has already succeeded by then, and a
    tunnel that did not come up must not make the command exit non-zero.
    """
    ok, msg = joind.apply_wg_conf(action)
    print("overlay %s: %s" % ("up" if ok else "not up", msg))


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="supermox-join")
    sub = ap.add_subparsers(dest="command", required=True)

    p = sub.add_parser("create", help="create the cluster with this node")
    p.add_argument("--name", required=True)
    p.add_argument("--endpoint", default="%s:%d" % ("127.0.0.1",
                                                    joind.DEFAULT_PORT))
    p.add_argument("--my-wg-endpoint", metavar="host:51820",
                   help="this node's WireGuard endpoint (default: the host "
                        "of --endpoint at port %d)"
                        % joind.WG_LISTEN_PORT)
    p.set_defaults(func=cmd_create)

    p = sub.add_parser("invite", help="create a single-use join invite")
    p.add_argument("--ttl", type=int, default=900)
    p.add_argument("--png", metavar="FILE")
    p.set_defaults(func=cmd_invite)

    p = sub.add_parser("join", help="join the cluster at --endpoint")
    p.add_argument("--name", required=True)
    p.add_argument("--endpoint", default="127.0.0.1")
    p.add_argument("--words", metavar="PHRASE")
    p.add_argument("--uri", metavar="supermox://...")
    p.add_argument("--arch", default=_arch())
    p.add_argument("--caps", default=None)
    p.add_argument("--my-endpoint", metavar="host:port",
                   help="advertise this node's join daemon to the cluster")
    p.add_argument("--my-wg-endpoint", metavar="host:51820",
                   help="this node's WireGuard endpoint (default: the host "
                        "of --my-endpoint/--endpoint at port %d)"
                        % joind.WG_LISTEN_PORT)
    p.set_defaults(func=cmd_join)

    p = sub.add_parser("conf", help="regenerate this node's wg0.conf from state")
    p.set_defaults(func=cmd_conf)

    p = sub.add_parser("cluster-init",
                       help="write this cluster's corosync nodelist "
                            "(idempotent; repairs a cluster whose corosync "
                            "step never ran)")
    p.set_defaults(func=cmd_cluster_init)

    p = sub.add_parser("core", help="make this node a corosync core member")
    p.add_argument("--write-only", action="store_true",
                   help="write /etc/corosync/authkey and corosync.conf and "
                        "stop, without calling upstream's finish_join")
    p.set_defaults(func=cmd_core)

    p = sub.add_parser("pending", help="list join requests waiting for approval")
    p.add_argument("--json", action="store_true",
                   help="one JSON array (id, name, arch, age_s) for the Manager")
    p.set_defaults(func=cmd_pending)

    for name in ("approve", "deny"):
        p = sub.add_parser(name, help="decide a pending join request")
        p.add_argument("request_id")
        p.add_argument("--endpoint", default="127.0.0.1")
        p.set_defaults(func=cmd_decide, command=name)

    p = sub.add_parser("members", help="list this cluster's members")
    p.add_argument("--json", action="store_true",
                   help="one JSON array (name, role, overlay_addr, arch, "
                        "caps, core) for the Manager")
    p.set_defaults(func=cmd_members)

    args = ap.parse_args(argv)
    try:
        return args.func(args)
    except joind.JoinError as exc:
        print("supermox-join: %s" % exc, file=sys.stderr)
        return 1
    except ValueError as exc:
        print("supermox-join: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
