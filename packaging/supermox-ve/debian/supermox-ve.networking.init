#!/bin/sh
### BEGIN INIT INFO
# Provides:          networking ifupdown
# Required-Start:    mountkernfs $local_fs urandom
# Required-Stop:     $local_fs
# Default-Start:     S
# Default-Stop:      0 6
# Short-Description: Brings up and shuts down the network interfaces
### END INIT INFO

# Sysvinit service script for ifupdown2. Upstream ifupdown2 ships only
# service-unit files (networking.service, ifup@.service) and no init script,
# so SuperMox provides this one itself. ifupdown2's ifup/ifdown/ifreload are
# Python front ends that accept -a and -X/--exclude.

. /lib/lsb/init-functions

NAME=networking

# ifupdown2's lock file lives at /run/network/.lock and its state dir is
# /run/network/. Upstream's start-networking creates these before invoking
# ifup/ifdown/ifreload; without them ifupdown2 reports a misleading
# "Another instance of this program is already running." error.
ifupdown_init() {
  [ -d /run/network ] || mkdir -p /run/network
  [ -e /etc/network/run ] || ln -s /run/network /etc/network/run
}

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    ifupdown_init
    ifup -a
    rc=$?
    # A failure caused only by loopback must not fail boot.
    if [ "$rc" -ne 0 ] && ifup -a --exclude=lo >/dev/null 2>&1; then
      rc=0
    fi
    log_end_msg "$rc"
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    ifupdown_init
    ifdown -a --exclude=lo
    log_end_msg $?
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    log_begin_msg "Reloading $NAME"
    ifupdown_init
    ifreload -a
    log_end_msg $?
    ;;
  status)
    # ifupdown2 records up interfaces in /run/network/ifstate as "iface=iface";
    # interfaces that are down are absent from that file.
    statefile=/run/network/ifstate
    up=""
    if [ -f "$statefile" ]; then
      for i in $(ifquery --list 2>/dev/null); do
        if grep -q "^$i=" "$statefile" 2>/dev/null; then
          up="${up:+$up }$i"
        fi
      done
    fi
    if [ -n "$up" ]; then
      log_success_msg "$NAME is up: $up"
      exit 0
    fi
    log_failure_msg "$NAME is not up"
    exit 3
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
