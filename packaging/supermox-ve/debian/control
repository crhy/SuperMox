Rules-Requires-Root: no

Package: supermox-ve
Architecture: all
Depends: apt,
         cpio,
         ifupdown2,
         openssh-client,
         openssh-server,
         proxmox-archive-keyring,
         pve-manager (>= 8.0.4),
         pve-qemu-kvm,
         qemu-server (>= 9.0~),
         sysvinit-core,
         linux-image-amd64 | linux-image-arm64 | linux-image-armmp-lpae | linux-image-riscv64 | linux-image-loong64,
         ${misc:Depends}
Conflicts: systemd-sysv, systemd, ifupdown
Replaces: ifupdown
Provides: proxmox-ve
Description: SuperMox virtualization stack
 Meta package that pulls in the SuperMox virtualization stack: the
 manager, QEMU-based virtual machine support, and the clustering and
 storage services. It is designed to run under sysvinit on Devuan, so
 it installs sysvinit-core and a Debian kernel package instead of a
 systemd-based init and the upstream kernel helper packages.
