#!/bin/sh
### BEGIN INIT INFO
# Provides:          spiceproxy
# Required-Start:    pveproxy
# Required-Stop:     pveproxy
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PVE SPICE Proxy Server
### END INIT INFO

# Sysvinit service script translated from
# upstream/pxvirt/packages/pve-manager/pve-manager/services/spiceproxy.service
# ExecStart=/usr/bin/spiceproxy start  ExecStop=/usr/bin/spiceproxy stop
# ExecReload=/usr/bin/spiceproxy restart  Type=forking  PIDFile=/run/pveproxy/spiceproxy.pid

. /lib/lsb/init-functions
export PVE_SYSV_INIT=1

DAEMON=/usr/bin/spiceproxy
PIDFILE=/run/pveproxy/spiceproxy.pid
NAME=spiceproxy

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    # A crashed master leaves `spiceproxy worker` orphans (parent pid 1) holding
    # the SPICE socket; free them before starting a new master.
    /usr/lib/supermox/supermox-reap-orphans "$NAME" "$PIDFILE"
    /usr/lib/supermox/supermox-logpipe "$NAME" "$DAEMON" start
    rc=$?
    # spiceproxy's own start can return 0 yet leave no live master; confirm the
    # pidfile pid is alive within 10s, else report failure.
    if [ "$rc" -eq 0 ]; then
      i=0
      while [ "$i" -lt 100 ]; do
        mpid=$(tr -cd '0-9' < "$PIDFILE" 2>/dev/null || true)
        if [ -n "$mpid" ] && kill -0 "$mpid" 2>/dev/null; then break; fi
        sleep 0.1
        i=$((i + 1))
      done
      mpid=$(tr -cd '0-9' < "$PIDFILE" 2>/dev/null || true)
      if [ -z "$mpid" ] || ! kill -0 "$mpid" 2>/dev/null; then rc=1; fi
    fi
    log_end_msg "$rc"
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    "$DAEMON" stop
    rc=$?
    # Reap any worker the master's stop did not reach (orphaned to pid 1).
    /usr/lib/supermox/supermox-reap-orphans "$NAME" "$PIDFILE"
    log_end_msg "$rc"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    log_begin_msg "Reloading $NAME"
    "$DAEMON" restart
    log_end_msg $?
    ;;
  status)
    # spiceproxy setuid's its master to www-data and writes its pidfile under
    # the www-data-owned /run/pveproxy dir. start-stop-daemon refuses to trust
    # a non-root pidfile on its own (exit 4), so cross-check the process owner.
    start-stop-daemon --status --quiet --pidfile "$PIDFILE" --user www-data
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_success_msg "$NAME is running"
    else
      log_failure_msg "$NAME is not running"
    fi
    exit "$rc"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
