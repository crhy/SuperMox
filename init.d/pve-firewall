#!/bin/sh
### BEGIN INIT INFO
# Provides:          pve-firewall
# Required-Start:    pvefw-logger pve-cluster $network kmod
# Required-Stop:     pvefw-logger pve-cluster $network kmod
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PVE firewall
### END INIT INFO

# Sysvinit service script translated from
# upstream/pxvirt/packages/pve-firewall/pve-firewall/debian/pve-firewall.service
# ExecStart=/usr/sbin/pve-firewall start  ExecStop=/usr/sbin/pve-firewall stop
# ExecReload=/usr/sbin/pve-firewall restart  Type=forking  PIDFile=/run/pve-firewall.pid
#
# Upstream's three ExecStartPre lines pinned the iptables family to the legacy
# backend; that translation is NOT copied here. SuperMox kernels carry no
# legacy ebtables bridge module (no ebtables.ko anywhere under /lib/modules,
# and `ebtables -L` answers "The kernel doesn't support the ebtables 'filter'
# table"), and the iptables `filter` table pve-firewall writes its rules into
# is that bridge table. So the legacy pin made every status update fail — one
# "status update error: modprobe: FATAL: Module ebtables not found" line in
# syslog every 10 seconds, firewall disabled or not (f10d-1). We release the
# pin instead and let Debian's default (the nft backend, priority 20) apply,
# which is the backend that works on our kernels.

. /lib/lsb/init-functions
export PVE_SYSV_INIT=1

DAEMON=/usr/sbin/pve-firewall
PIDFILE=/run/pve-firewall.pid
NAME=pve-firewall

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    # Undo upstream's legacy pinning rather than reproducing it (see above).
    update-alternatives --auto ebtables 2>/dev/null || true
    update-alternatives --auto iptables 2>/dev/null || true
    update-alternatives --auto ip6tables 2>/dev/null || true
    /usr/lib/supermox/supermox-logpipe "$NAME" "$DAEMON" start
    log_end_msg $?
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    "$DAEMON" stop
    log_end_msg $?
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    log_begin_msg "Reloading $NAME"
    "$DAEMON" restart
    log_end_msg $?
    ;;
  status)
    start-stop-daemon --status --quiet --pidfile "$PIDFILE"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_success_msg "$NAME is running"
    else
      log_failure_msg "$NAME is not running"
    fi
    exit "$rc"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
