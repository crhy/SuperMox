#!/bin/sh
### BEGIN INIT INFO
# Provides:          pve-cluster
# Required-Start:    $network $time corosync
# Required-Stop:     $network $time corosync
# Should-Start:      rrdcached
# Should-Stop:       rrdcached
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: The PVE cluster filesystem
### END INIT INFO

# Sysvinit service script for pmxcfs, translated from
# upstream/pxvirt/packages/pve-cluster/pve-cluster/debian/pve-cluster.service
# ExecStart=/usr/bin/pmxcfs  Type=forking  PIDFile=/run/pve-cluster.pid
#
# pmxcfs runs in its normal (corosync) mode, NOT local mode. It does NOT spawn
# corosync itself: it connects to a running corosync daemon over the corosync
# quorum API. So corosync must be started first, and its state directory
# /var/lib/corosync (plus the /run/corosync socket dir) must exist. The single-node
# /etc/corosync/corosync.conf is written by the pve-cluster postinst.

. /lib/lsb/init-functions

DAEMON=/usr/bin/pmxcfs
PIDFILE=/run/pve-cluster.pid
NAME=pve-cluster

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    mkdir -p /etc/pve /var/lib/corosync /run/corosync
    if [ -x /etc/init.d/corosync ]; then
      /etc/init.d/corosync start >/dev/null 2>&1
    fi
    /usr/lib/supermox/supermox-logpipe "$NAME" start-stop-daemon --start --quiet --pidfile "$PIDFILE" --exec "$DAEMON"
    log_end_msg $?
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry TERM/10/KILL/5
    log_end_msg $?
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    "$0" restart
    ;;
  status)
    start-stop-daemon --status --quiet --pidfile "$PIDFILE"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_success_msg "$NAME is running"
    else
      log_failure_msg "$NAME is not running"
    fi
    exit "$rc"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
