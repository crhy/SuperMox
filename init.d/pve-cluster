#!/bin/sh
### BEGIN INIT INFO
# Provides:          pve-cluster
# Required-Start:    $network $time corosync supermox-corosync
# Required-Stop:     $network $time corosync
# Should-Start:      rrdcached
# Should-Stop:       rrdcached
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: The PVE cluster filesystem
### END INIT INFO

# Sysvinit service script for pmxcfs, translated from
# upstream/pxvirt/packages/pve-cluster/pve-cluster/debian/pve-cluster.service
# ExecStart=/usr/bin/pmxcfs  Type=forking  PIDFile=/run/pve-cluster.pid
#
# pmxcfs runs in its normal (corosync) mode, NOT local mode. It does NOT spawn
# corosync itself: it connects to a running corosync daemon over the corosync
# quorum API. So corosync must be started first, and its state directory
# /var/lib/corosync (plus the /run/corosync socket dir) must exist. The single-node
# /etc/corosync/corosync.conf is written by the pve-cluster postinst.

. /lib/lsb/init-functions

DAEMON=/usr/bin/pmxcfs
PIDFILE=/run/pve-cluster.pid
NAME=pve-cluster
STORAGE_CFG=/etc/pve/storage.cfg

# pmxcfs creates /etc/pve/storage.cfg empty and no package in the tree ever
# fills it (checked: pve-storage's postinst only migrates an existing file), so
# a clean node boots with no storage defined at all. Everything that needs a
# volume then fails with a misleading message -- `pct create` and the web UI's
# Create CT both say "volume 'local:...' does not exist", `pvesm list local`
# says the storage id is unknown -- so this script seeds the one stanza a
# single-node SuperMox node always wants, the local directory storage under
# /var/lib/vz. It writes only when no storage is defined yet, so an admin's
# (or a cluster's) storage.cfg is never touched, and it waits for the cluster
# filesystem to be mounted before writing: a write to /etc/pve before pmxcfs
# is up lands in the plain directory and is lost when the mount covers it.
seed_storage_cfg() {
  i=0
  while [ "$i" -lt 10 ]; do
    mountpoint -q /etc/pve && break
    i=$((i + 1))
    sleep 1
  done
  if [ "$i" -ge 10 ]; then
    log_warning_msg "$NAME: /etc/pve is not mounted, storage.cfg not seeded"
    return 0
  fi
  if [ -s "$STORAGE_CFG" ]; then
    return 0
  fi
  printf '%s\n' 'dir: local' ' path /var/lib/vz' ' content images,rootdir,vztmpl,iso,backup,snippets,import' > "$STORAGE_CFG" || {
    log_warning_msg "$NAME: could not write $STORAGE_CFG"
    return 0
  }
}

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    mkdir -p /etc/pve /var/lib/corosync /run/corosync
    if [ -x /etc/init.d/corosync ]; then
      /etc/init.d/corosync start >/dev/null 2>&1
    fi
    /usr/lib/supermox/supermox-logpipe "$NAME" start-stop-daemon --start --quiet --pidfile "$PIDFILE" --exec "$DAEMON"
    rc=$?
    seed_storage_cfg
    log_end_msg "$rc"
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry TERM/10/KILL/5
    log_end_msg $?
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    "$0" restart
    ;;
  status)
    start-stop-daemon --status --quiet --pidfile "$PIDFILE"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_success_msg "$NAME is running"
    else
      log_failure_msg "$NAME is not running"
    fi
    exit "$rc"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
