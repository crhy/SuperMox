#!/bin/sh
### BEGIN INIT INFO
# Provides:          pve-ha-lrm
# Required-Start:    corosync lxc pve-cluster pve-ha-crm pvedaemon pveproxy ssh syslog watchdog-mux
# Required-Stop:     corosync lxc pve-cluster pve-ha-crm pvedaemon pveproxy ssh syslog watchdog-mux
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PVE Local HA Resource Manager Daemon
### END INIT INFO

# Sysvinit service script translated from
# upstream/pxvirt/packages/pve-ha-manager/pve-ha-manager/debian/pve-ha-lrm.service
# ExecStart=/usr/sbin/pve-ha-lrm start  ExecStop=/usr/sbin/pve-ha-lrm stop
# Type=forking  PIDFile=/run/pve-ha-lrm.pid  TimeoutStopSec=infinity  KillMode=process

. /lib/lsb/init-functions
export PVE_SYSV_INIT=1

DAEMON=/usr/sbin/pve-ha-lrm
PIDFILE=/run/pve-ha-lrm.pid
NAME=pve-ha-lrm

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    "$DAEMON" start
    log_end_msg $?
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    "$DAEMON" stop
    log_end_msg $?
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    "$0" restart
    ;;
  status)
    start-stop-daemon --status --quiet --pidfile "$PIDFILE"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_success_msg "$NAME is running"
    else
      log_failure_msg "$NAME is not running"
    fi
    exit "$rc"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
