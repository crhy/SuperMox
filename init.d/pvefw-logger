#!/bin/sh
### BEGIN INIT INFO
# Provides:          pvefw-logger
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PVE firewall logger
### END INIT INFO

# Sysvinit service script translated from
# upstream/pxvirt/packages/pve-firewall/pve-firewall/debian/pvefw-logger.service
# ExecStart=/usr/sbin/pvefw-logger  Type=forking  PIDFile=/run/pvefw-logger.pid
# TimeoutStopSec=5

. /lib/lsb/init-functions

DAEMON=/usr/sbin/pvefw-logger
PIDFILE=/run/pvefw-logger.pid
NAME=pvefw-logger

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    "$DAEMON"
    log_end_msg $?
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    start-stop-daemon --stop --quiet --retry TERM/5/KILL/5 --pidfile "$PIDFILE"
    log_end_msg $?
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    "$0" restart
    ;;
  status)
    start-stop-daemon --status --quiet --pidfile "$PIDFILE"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_success_msg "$NAME is running"
    else
      log_failure_msg "$NAME is not running"
    fi
    exit "$rc"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
