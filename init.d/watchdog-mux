#!/bin/sh
### BEGIN INIT INFO
# Provides:          watchdog-mux
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PVE watchdog multiplexer
### END INIT INFO

# Sysvinit service script translated from
# upstream/pxvirt/packages/pve-ha-manager/pve-ha-manager/debian/watchdog-mux.service
# ExecStart=/usr/sbin/watchdog-mux
# watchdog-mux does not fork itself: started with start-stop-daemon --background
# --make-pidfile, pidfile /run/watchdog-mux.pid.

. /lib/lsb/init-functions

DAEMON=/usr/sbin/watchdog-mux
PIDFILE=/run/watchdog-mux.pid
NAME=watchdog-mux

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$PIDFILE" --exec "$DAEMON"
    log_end_msg $?
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    start-stop-daemon --stop --quiet --pidfile "$PIDFILE"
    log_end_msg $?
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  reload|force-reload)
    "$0" restart
    ;;
  status)
    start-stop-daemon --status --quiet --pidfile "$PIDFILE"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_success_msg "$NAME is running"
    else
      log_failure_msg "$NAME is not running"
    fi
    exit "$rc"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|force-reload|status}" >&2
    exit 2
    ;;
esac

exit 0
