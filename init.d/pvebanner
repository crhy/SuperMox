#!/bin/sh
### BEGIN INIT INFO
# Provides:          pvebanner
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PVE Login Banner
### END INIT INFO

# Sysvinit service script translated from
# upstream/pxvirt/packages/pve-manager/pve-manager/services/pvebanner.service
# Type=oneshot  RemainAfterExit=yes  ConditionPathExists=/usr/bin/pvebanner
# ExecStart=/usr/bin/pvebanner  (no ExecStop)
# After=local-fs.target -> $local_fs; DefaultDependencies=no, Before=console-getty dropped.

. /lib/lsb/init-functions
export PVE_SYSV_INIT=1

NAME=pvebanner

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    /usr/bin/pvebanner
    log_end_msg $?
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    log_end_msg 0
    ;;
  restart)
    "$0" start
    ;;
  status)
    log_success_msg "$NAME is a oneshot task (no daemon)"
    exit 0
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 2
    ;;
esac

exit 0
