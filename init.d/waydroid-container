#!/bin/sh
### BEGIN INIT INFO
# Provides:          waydroid-container
# Required-Start:    $network $local_fs dbus
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Waydroid Android container (the phone's UI layer)
### END INIT INFO

# Sysvinit service script for the Waydroid Android container. Upstream
# waydroid only ships a unit file for an init system we do not use, and
# dpkg's path-exclude (config in /etc/dpkg/dpkg.cfg.d) drops that file on
# install, so nothing else starts the container on a SuperMox node.
#
# The container is the Android userspace: an LXC container that shares this
# node's kernel and needs the binder mounts (binder_linux) and the system
# D-Bus bus (id.waydro.Container) to talk to. `waydroid container start`
# runs in the foreground and tears itself down on SIGTERM (unmounts the
# rootfs, removes its tap/veth, stops sensord), so TERM is a clean stop;
# start-stop-daemon records the pid in /run and TERM is what stop sends.
#
# Refusing to start when the image is not initialized is deliberate:
# without /var/lib/waydroid/waydroid.cfg the container would fail anyway,
# and the fix (run /usr/sbin/supermox-android-setup) is not something a
# boot script should do by itself, because it downloads about 1 GB.

. /lib/lsb/init-functions

NAME=waydroid-container
DAEMON=${WAYDROID_BIN:-/usr/bin/waydroid}
PIDFILE=${WAYDROID_PIDFILE:-/run/waydroid-container.pid}
CONF=${WAYDROID_CONF:-/var/lib/waydroid/waydroid.cfg}

# waydroid's container manager bind-mounts with the binder API; without the
# module the container dies on start. Load it here as well as through
# /etc/modules-load.d/waydroid.conf, so a node that just installed the
# package does not have to reboot.
load_binder() {
  if [ -e /dev/binder ]; then
    return 0
  fi
  modprobe binder_linux devices=binder,hwbinder,vndbinder 2>/dev/null
  return 0
}

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    if [ ! -x "$DAEMON" ]; then
      log_end_msg 1
      exit 1
    fi
    if [ ! -f "$CONF" ]; then
      printf '%s: %s not initialized (%s missing); run supermox-android-setup first\n' "$NAME" "$NAME" "$CONF" >&2
      log_end_msg 1
      exit 1
    fi
    load_binder
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$PIDFILE" --exec "$DAEMON" -- container start
    rc=$?
    if [ "$rc" -ne 0 ]; then
      log_end_msg "$rc"
      exit "$rc"
    fi
    # The daemon forks into the background; give it a moment to fail fast
    # (missing image, no D-Bus bus) so a broken start is reported, not hidden.
    sleep 2
    if [ -f "$PIDFILE" ] && ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      rm -f "$PIDFILE"
      log_end_msg 1
      exit 1
    fi
    log_end_msg 0
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      # TERM, the daemon's clean shutdown path; KILL only if it is stubborn.
      start-stop-daemon --stop --quiet --retry=TERM/20/KILL/5 --pidfile "$PIDFILE"
      rc=$?
    else
      # No live pid: the container may still be up (started by hand).
      "$DAEMON" container stop >/dev/null 2>&1 || true
      rc=0
    fi
    rm -f "$PIDFILE"
    log_end_msg "$rc"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      printf '%s is running (pid %s)\n' "$NAME" "$(cat "$PIDFILE")"
      exit 0
    fi
    printf '%s is not running\n' "$NAME"
    exit 3
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 2
    ;;
esac

exit 0
