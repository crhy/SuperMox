#!/bin/sh
### BEGIN INIT INFO
# Provides:          waydroid-container
# Required-Start:    $network $local_fs dbus
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Waydroid Android container (the phone's UI layer)
### END INIT INFO

# Sysvinit service script for the Waydroid Android container. Upstream
# waydroid only ships a unit file for an init system we do not use, and
# dpkg's path-exclude (config in /etc/dpkg/dpkg.cfg.d) drops that file on
# install, so nothing else starts the container on a SuperMox node.
#
# The container is the Android userspace: an LXC container that shares this
# node's kernel and needs the binder mounts (binder_linux) and the system
# D-Bus bus (id.waydro.Container) to talk to. Two processes are managed:
# `waydroid container start` is the D-Bus container manager — it runs in the
# foreground, records its pid in /run and takes SIGTERM cleanly; and the LXC
# container itself, which we bring up headlessly (prepare_container creates
# the waydroid0 veth bridge and loop-mounts the images, start_container runs
# `lxc-start -F -- /init` and records its pid in /run/waydroid-container.lxc.pid).
# The headless path deliberately skips the session layer's Wayland/pulse bind
# mounts: only the GUI session needs a compositor, not the container.
#
# Refusing to start when the image is not initialized is deliberate:
# without the image files under /var/lib/waydroid/images the container would
# fail anyway (its LXC config loop-mounts them), and the daemon would still
# park on its D-Bus listener, so a start that looks fine reports success while
# the Android layer is dead.
# and the fix (run /usr/sbin/supermox-android-setup) is not something a
# boot script should do by itself, because it downloads about 1 GB.

. /lib/lsb/init-functions

NAME=waydroid-container
DAEMON=${WAYDROID_BIN:-/usr/bin/waydroid}
PIDFILE=${WAYDROID_PIDFILE:-/run/waydroid-container.pid}
CONF=${WAYDROID_CONF:-/var/lib/waydroid/waydroid.cfg}
IMG_DIR=${WAYDROID_IMG_DIR:-/var/lib/waydroid/images}
LXC_DIR=${WAYDROID_LXC_DIR:-/var/lib/waydroid/lxc}
ROOTFS=${WAYDROID_ROOTFS:-/var/lib/waydroid/rootfs}
NET_SH=${WAYDROID_NET_SH:-/usr/lib/waydroid/data/scripts/waydroid-net.sh}
LXC_BIN=${WAYDROID_LXC_BIN:-/usr/bin/lxc-start}
CONT_PIDFILE=${WAYDROID_CONTAINER_PIDFILE:-/run/waydroid-container.lxc.pid}
LXC_INFO=${WAYDROID_LXC_INFO:-/usr/bin/lxc-info}
# How long start waits for the container to reach RUNNING (seconds).
WAIT_SECS=${WAYDROID_WAIT_SECS:-15}

# waydroid's container manager bind-mounts with the binder API; without the
# module the container dies on start. Load it here as well as through
# /etc/modules-load.d/waydroid.conf, so a node that just installed the
# package does not have to reboot.
load_binder() {
  if [ ! -e /dev/binder ]; then
    modprobe binder_linux devices=binder,hwbinder,vndbinder 2>/dev/null
  fi
  # Android's init opens these nodes as non-root UIDs; the kernel creates them
  # 0600 (root-only), so the opens fail with EACCES and init aborts. Match
  # Android/waydroid binderfs nodes and make them world-accessible.
  chmod 666 /dev/binder /dev/hwbinder /dev/vndbinder 2>/dev/null
  return 0
}

# The container's LXC config (lxc.net.0.link = waydroid0, lxc.rootfs.path =
# rootfs) needs two host-side prerequisites that upstream only creates inside
# the container manager's do_start(): the waydroid0 veth bridge (waydroid-net.sh
# start) and the loop-mounted Android rootfs (mount_rootfs). do_start() only
# runs when a Wayland session calls Start() on id.waydro.Container, and the
# session manager refuses to start without a live Wayland compositor. So on a
# headless node the container is never brought up at all: lxc-start aborts at
# once ("Failed to attach veth ... bridge interface doesn't exist", then the
# tmpfs /dev mount on an empty rootfs). Create the prerequisites here so the
# container can run headless; only the GUI session layer needs a compositor.
prepare_container() {
  [ -x "$NET_SH" ] && "$NET_SH" start
  if ! mountpoint -q "$ROOTFS"; then
    mkdir -p "$ROOTFS" "$ROOTFS/vendor"
    mount -o loop "$IMG_DIR/system.img" "$ROOTFS" || return 1
    mount -o loop "$IMG_DIR/vendor.img" "$ROOTFS/vendor" || return 1
  fi
  return 0
}

# Start the container directly (headless). The container shares this node's
# kernel and needs no compositor; we deliberately do NOT go through the session
# layer, whose generate_session_lxc_config() bind-mounts the host Wayland and
# pulse sockets ($XDG_RUNTIME_DIR/$WAYLAND_DISPLAY, .../pulse/native) that do
# not exist on a headless node and would make LXC's mount setup fail.
start_container() {
  start-stop-daemon --start --quiet --background --make-pidfile \
    --pidfile "$CONT_PIDFILE" \
    --exec "$LXC_BIN" -- -n waydroid -P "$LXC_DIR" -F -- /init
}

stop_container() {
  if [ -f "$CONT_PIDFILE" ] && kill -0 "$(cat "$CONT_PIDFILE")" 2>/dev/null; then
    start-stop-daemon --stop --quiet --retry=TERM/20/KILL/5 --pidfile "$CONT_PIDFILE"
  fi
  lxc-stop -n waydroid -P "$LXC_DIR" 2>/dev/null || true
  umount "$ROOTFS/vendor" 2>/dev/null || true
  umount "$ROOTFS" 2>/dev/null || true
  [ -x "$NET_SH" ] && "$NET_SH" stop
  rm -f "$CONT_PIDFILE"
  return 0
}

# TERM/KILL the container manager daemon by pidfile (its clean shutdown path).
stop_daemon() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    start-stop-daemon --stop --quiet --retry=TERM/20/KILL/5 --pidfile "$PIDFILE"
  fi
  rm -f "$PIDFILE"
  return 0
}

# The LXC state of the container, as lxc-info prints it ("RUNNING", "STOPPED",
# ...); empty when lxc-info is missing or the container does not exist.
container_state() {
  "$LXC_INFO" -n waydroid -P "$LXC_DIR" -s 2>/dev/null
}

container_running() {
  case "$(container_state)" in
    *RUNNING*) return 0 ;;
  esac
  return 1
}

# Poll for the container to reach RUNNING. lxc-start -F only returns once the
# container is up, and a container that dies at once (bad config, missing binder
# nodes) leaves both pidfiles looking fine, so the state - not the pids - is
# what proves the Android layer is actually alive.
wait_container() {
  i=0
  while [ "$i" -lt "$WAIT_SECS" ]; do
    container_running && return 0
    sleep 1
    i=$((i + 1))
  done
  return 1
}

case "$1" in
  start)
    log_begin_msg "Starting $NAME"
    if [ ! -x "$DAEMON" ]; then
      log_end_msg 1
      exit 1
    fi
    missing=""
    for f in "$CONF" "$IMG_DIR/system.img" "$IMG_DIR/vendor.img"; do
      [ -f "$f" ] || missing="$missing $f"
    done
    if [ -n "$missing" ]; then
      printf '%s: %s not initialized (%s missing); run supermox-android-setup first\n' "$NAME" "$NAME" "$missing" >&2
      log_end_msg 1
      exit 1
    fi
    load_binder
    if ! prepare_container; then
      log_end_msg 1
      exit 1
    fi
    start_container
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$PIDFILE" --exec "$DAEMON" -- container start
    rc=$?
    if [ "$rc" -ne 0 ]; then
      log_end_msg "$rc"
      exit "$rc"
    fi
    # The daemon forks into the background; give it a moment to fail fast
    # (missing image, no D-Bus bus) so a broken start is reported, not hidden.
    sleep 2
    if [ -f "$PIDFILE" ] && ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      rm -f "$PIDFILE"
      log_end_msg 1
      exit 1
    fi
    # Success means the container is RUNNING, not merely that two processes
    # were launched: a container that dies at once (the t60b failure) must not
    # report a clean start. Undo whatever was started before failing.
    if ! wait_container; then
      log_failure_msg "$NAME: container did not reach RUNNING state within ${WAIT_SECS}s"
      stop_daemon
      stop_container
      exit 1
    fi
    log_end_msg 0
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      # TERM, the daemon's clean shutdown path; KILL only if it is stubborn.
      start-stop-daemon --stop --quiet --retry=TERM/20/KILL/5 --pidfile "$PIDFILE"
      rc=$?
    else
      # No live pid: the container may still be up (started by hand), and so
      # may the service daemon itself - /run is cleared on reboot, and a
      # daemon left behind keeps its D-Bus name, which makes a later start
      # fail with "already running".
      "$DAEMON" container stop >/dev/null 2>&1 || true
      pkill -f "$DAEMON container start" 2>/dev/null || true
      rc=0
    fi
    stop_container
    rm -f "$PIDFILE"
    log_end_msg "$rc"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    daemon_pid=""
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      daemon_pid=$(cat "$PIDFILE")
    else
      # The daemon outlives /run across a reboot, so a missing pidfile does
      # not mean not running; match the daemon's own command line.
      orphan=$(pgrep -f "$DAEMON container start" | head -1)
      [ -n "$orphan" ] && daemon_pid=$orphan
    fi
    state=$(container_state)
    running=0
    case "$state" in *RUNNING*) running=1 ;; esac
    # Running means both halves: the manager daemon AND a RUNNING container.
    if [ -n "$daemon_pid" ] && [ "$running" = 1 ]; then
      printf '%s is running (daemon pid %s, container RUNNING)\n' "$NAME" "$daemon_pid"
      exit 0
    fi
    if [ -z "$daemon_pid" ] && [ "$running" = 0 ]; then
      printf '%s is not running\n' "$NAME"
      exit 3
    fi
    # Exactly one half is up (daemon without a container, or a container
    # brought up by hand without the daemon): the service is half-broken and
    # a boot must not read that as healthy. LSB 1 = "dead but pid file exists"
    # is the closest code for a service that is only partly up.
    [ -n "$state" ] || state="not RUNNING"
    printf '%s: daemon %s, container %s\n' "$NAME" "${daemon_pid:-not running}" "$state"
    exit 1
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 2
    ;;
esac

exit 0
