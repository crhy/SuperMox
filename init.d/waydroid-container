#!/bin/sh
### BEGIN INIT INFO
# Provides:          waydroid-container
# Required-Start:    $network $local_fs dbus
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Waydroid Android layer (container and session halves)
### END INIT INFO

# Sysvinit service script for the Waydroid Android layer on a SuperMox node.
# Upstream waydroid only ships a unit file for an init system we do not use,
# and dpkg's path-exclude (config in /etc/dpkg/dpkg.cfg.d) drops that file on
# install, so nothing else starts the Android layer on a SuperMox node.
#
# The layer has two halves and this ONE script owns both, because the package
# ships one update-rc.d entry (dh_installinit --name=waydroid-container):
#
#   container  `waydroid container start` - the Android userspace: an LXC
#              container sharing this node's kernel, which needs the binder
#              mounts (binder_linux) and the system D-Bus bus
#              (id.waydro.Container) its init talks to. It runs in the
#              foreground and tears itself down on SIGTERM (unmounts the
#              rootfs, removes its tap/veth, stops sensord), so TERM is a
#              clean stop; start-stop-daemon records the pid in /run and TERM
#              is what stop sends. Pidfile: $PIDFILE.
#   session    `waydroid session start` - the UI layer on top of the container.
#              Its LXC config bind-mounts the host Wayland socket into the
#              container, so it needs a live compositor, and it is the half
#              that exposes the Android platform service (`waydroid app
#              install`, `waydroid prop set`) supermox-android-setup uses.
#              Pidfile: $SESSION_PIDFILE.
#
# The container -> session handover, decided here rather than left undesigned:
# `start` brings up the container half and PROVES it, and never starts a
# session by itself - a headless node would park a dead session next to a
# live container and report success. `session-start` is the explicit second
# half of the handover: it refuses unless the container is proven RUNNING and
# a Wayland socket exists, naming the half that is missing. `stop` tears the
# session down BEFORE the container; `restart` stays container-only.
#
# Refusing to start when the image is not initialized is deliberate:
# without the image files under /var/lib/waydroid/images the container would
# fail anyway (its LXC config loop-mounts them), and the daemon would still
# park on its D-Bus listener, so a start that looks fine reports success while
# the Android layer is dead.
# and the fix (run /usr/sbin/supermox-android-setup) is not something a
# boot script should do by itself, because it downloads about 1 GB.

. /lib/lsb/init-functions

NAME=waydroid-container
DAEMON=${WAYDROID_BIN:-/usr/bin/waydroid}
PIDFILE=${WAYDROID_PIDFILE:-/run/waydroid-container.pid}
SESSION_PIDFILE=${WAYDROID_SESSION_PIDFILE:-/run/waydroid-session.pid}
CONF=${WAYDROID_CONF:-/var/lib/waydroid/waydroid.cfg}
IMG_DIR=${WAYDROID_IMG_DIR:-/var/lib/waydroid/images}
# The LXC name waydroid gives its container; lxc-info is asked for this.
LXC_NAME=${WAYDROID_LXC_NAME:-waydroid}
# How long to wait for a half to prove itself (1 s per try).
TRIES=${WAYDROID_PROVE_TRIES:-10}

# waydroid's container manager bind-mounts with the binder API; without the
# module the container dies on start. Load it here as well as through
# /etc/modules-load.d/waydroid.conf, so a node that just installed the
# package does not have to reboot.
load_binder() {
  if [ ! -e /dev/binder ]; then
    modprobe binder_linux devices=binder,hwbinder,vndbinder 2>/dev/null
  fi
  # Android's init opens these nodes as non-root UIDs; the kernel creates them
  # 0600 (root-only), so the opens fail with EACCES and init aborts. Match
  # Android/waydroid binderfs nodes and make them world-accessible.
  chmod 666 /dev/binder /dev/hwbinder /dev/vndbinder 2>/dev/null
  return 0
}

# The manager, not the pidfile, decides whether a half is up. The pid only
# says a process was forked; these state lines are what waydroid itself
# reports and what supermox-android-setup and the release audit check.
container_state() {
  # The lxc tools are authoritative where they are installed; waydroid's
  # own status output is the fallback on nodes without them.
  if command -v lxc-info >/dev/null 2>&1; then
    lxc-info -n "$LXC_NAME" --state --no-header 2>/dev/null | tr -d ' \t\r\n'
  else
    "$DAEMON" status 2>/dev/null | sed -n 's/^Container:[[:space:]]*//p' |
      head -1
  fi
}

session_state() {
  # The session half is not an LXC container: only waydroid knows about it.
  "$DAEMON" status 2>/dev/null | sed -n 's/^Session:[[:space:]]*//p' |
    head -1
}

# Prove a half after forking it: the recorded pid must stay alive AND the
# manager must report RUNNING. Failing fast matters more than waiting long -
# a broken start must be reported, not hidden behind a fixed sleep.
prove_half() {
  # $1 = pidfile of the half, $2 = function that reports its state
  i=0
  while [ "$i" -lt "$TRIES" ]; do
    state=$("$2")
    if [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null &&
      [ "$state" = "RUNNING" ]; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  return 1
}

# A live pid for a half: the pidfile first, else the daemon's own command
# line, because /run is cleared on reboot while the daemon survives.
live_pid() {
  # $1 = pidfile, $2 = command line fragment of that half's daemon
  if [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; then
    cat "$1"
    return 0
  fi
  orphan=$(pgrep -f "$DAEMON $2" | head -1)
  if [ -n "$orphan" ]; then
    # Trailing | marks "found without a pidfile", so status can say so.
    printf '%s|\n' "$orphan"
  fi
  return 0
}

# Format a live_pid result for a status line.
pid_note() {
  case "$1" in
    '') printf '' ;;
    *'|') printf ' (pid %s, no pidfile)' "${1%|}" ;;
    *) printf ' (pid %s)' "$1" ;;
  esac
}

# Where the compositor socket is. The session layer bind-mounts it, so a
# session without one starts and dies; refuse instead of pretending.
wayland_socket() {
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    for s in "$XDG_RUNTIME_DIR"/wayland-*.sock; do
      [ -S "$s" ] && printf '%s\n' "$s" && return 0
    done
  fi
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    # Set but not resolvable as a socket: still the compositor's name, and
    # enough to know a compositor was asked for.
    printf 'WAYLAND_DISPLAY=%s\n' "$WAYLAND_DISPLAY"
  fi
  return 0
}

# Tear the session half down. Never touches the container: the session is
# the UI layer on top of it, and stopping it must not kill the Android
# userspace underneath.
stop_session() {
  if [ -f "$SESSION_PIDFILE" ] &&
    kill -0 "$(cat "$SESSION_PIDFILE")" 2>/dev/null; then
    # TERM, the session's clean shutdown path; KILL only if it is stubborn.
    start-stop-daemon --stop --quiet --retry=TERM/20/KILL/5 \
      --pidfile "$SESSION_PIDFILE"
    rc=$?
  else
    # No live pid: /run is cleared on reboot while the session daemon may
    # still be up (started by hand). Ask the manager; it is idempotent.
    "$DAEMON" session stop >/dev/null 2>&1 || true
    rc=0
  fi
  rm -f "$SESSION_PIDFILE"
  return "$rc"
}

stop_container() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    # TERM, the daemon's clean shutdown path; KILL only if it is stubborn.
    start-stop-daemon --stop --quiet --retry=TERM/20/KILL/5 --pidfile "$PIDFILE"
    rc=$?
  else
    # No live pid: the container may still be up (started by hand), and so
    # may the service daemon itself - /run is cleared on reboot, and a
    # daemon left behind keeps its D-Bus name, which makes a later start
    # fail with "already running".
    "$DAEMON" container stop >/dev/null 2>&1 || true
    pkill -f "$DAEMON container start" 2>/dev/null || true
    rc=0
  fi
  rm -f "$PIDFILE"
  return "$rc"
}

case "$1" in
  start)
    log_begin_msg "Starting $NAME (container half)"
    if [ ! -x "$DAEMON" ]; then
      log_end_msg 1
      exit 1
    fi
    missing=""
    for f in "$CONF" "$IMG_DIR/system.img" "$IMG_DIR/vendor.img"; do
      [ -f "$f" ] || missing="$missing $f"
    done
    if [ -n "$missing" ]; then
      printf '%s: %s not initialized (%s missing); run supermox-android-setup first\n' "$NAME" "$NAME" "$missing" >&2
      log_end_msg 1
      exit 1
    fi
    load_binder
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$PIDFILE" --exec "$DAEMON" -- container start
    rc=$?
    if [ "$rc" -ne 0 ]; then
      log_end_msg "$rc"
      exit "$rc"
    fi
    # The fork is not proof: wait for the recorded pid to stay alive and for
    # the manager to report the container RUNNING, and name the half that
    # failed if it does not.
    if ! prove_half "$PIDFILE" container_state; then
      printf '%s: container half failed to come up (pid %s, state %s)\n' \
        "$NAME" "$(cat "$PIDFILE" 2>/dev/null)" "$(container_state)" >&2
      "$DAEMON" container stop >/dev/null 2>&1 || true
      rm -f "$PIDFILE"
      log_end_msg 1
      exit 1
    fi
    # The session half is deliberately NOT started here: it needs a Wayland
    # compositor this boot may not have. Run session-start once one is up.
    log_end_msg 0
    ;;
  session-start)
    log_begin_msg "Starting $NAME (session half)"
    if [ ! -x "$DAEMON" ]; then
      log_end_msg 1
      exit 1
    fi
    # (a) the container half must be proven RUNNING first: the session
    # bind-mounts into the container's rootfs.
    if [ "$(container_state)" != "RUNNING" ]; then
      printf '%s: session half refused, container half is %s (run start first)\n' \
        "$NAME" "$(container_state)" >&2
      log_end_msg 1
      exit 1
    fi
    # (b) a Wayland socket, because the session layer bind-mounts the
    # compositor socket into the container.
    if [ -z "$(wayland_socket)" ]; then
      printf '%s: session half refused, no Wayland socket (set WAYLAND_DISPLAY, or put wayland-*.sock in XDG_RUNTIME_DIR, once a compositor is up)\n' "$NAME" >&2
      log_end_msg 1
      exit 1
    fi
    start-stop-daemon --start --quiet --background --make-pidfile \
      --pidfile "$SESSION_PIDFILE" --exec "$DAEMON" -- session start
    rc=$?
    if [ "$rc" -ne 0 ]; then
      log_end_msg "$rc"
      exit "$rc"
    fi
    if ! prove_half "$SESSION_PIDFILE" session_state; then
      printf '%s: session half failed to come up (pid %s, state %s)\n' \
        "$NAME" "$(cat "$SESSION_PIDFILE" 2>/dev/null)" "$(session_state)" >&2
      "$DAEMON" session stop >/dev/null 2>&1 || true
      rm -f "$SESSION_PIDFILE"
      log_end_msg 1
      exit 1
    fi
    log_end_msg 0
    ;;
  stop)
    log_begin_msg "Stopping $NAME"
    # Session first: it holds the container's Wayland bind mount, and
    # tearing the container down underneath it leaves the session daemon
    # holding dead mounts.
    stop_session
    rc_session=$?
    stop_container
    rc_container=$?
    rc="$rc_container"
    [ "$rc_session" -ne 0 ] && rc="$rc_session"
    log_end_msg "$rc"
    exit "$rc"
    ;;
  session-stop)
    log_begin_msg "Stopping $NAME (session half)"
    stop_session
    rc=$?
    log_end_msg "$rc"
    exit "$rc"
    ;;
  session-status)
    sstate=$(session_state)
    spid=$(live_pid "$SESSION_PIDFILE" "session start")
    snote=$(pid_note "$spid")
    if [ "$sstate" = "RUNNING" ] || [ -n "$spid" ]; then
      printf '%s session is running%s\n' "$NAME" "$snote"
      exit 0
    fi
    printf '%s session is not running (state %s)\n' "$NAME" "$sstate"
    exit 3
    ;;
  restart)
    # Container-only on purpose: stop tears both halves down, start brings
    # the container back and proves it, and the session half returns only
    # when an explicit session-start runs with a compositor present.
    "$0" stop
    "$0" start
    ;;
  status)
    cstate=$(container_state)
    sstate=$(session_state)
    cpid=$(live_pid "$PIDFILE" "container start")
    spid=$(live_pid "$SESSION_PIDFILE" "session start")
    cnote=$(pid_note "$cpid")
    snote=$(pid_note "$spid")
    if [ "$cstate" = "RUNNING" ] || [ -n "$cpid" ]; then
      printf '%s container is running%s\n' "$NAME" "$cnote"
      c=0
    else
      printf '%s container is not running (state %s)\n' "$NAME" "$cstate"
      c=3
    fi
    if [ "$sstate" = "RUNNING" ] || [ -n "$spid" ]; then
      printf '%s session is running%s\n' "$NAME" "$snote"
      s=0
    else
      printf '%s session is not running (state %s)\n' "$NAME" "$sstate"
      s=3
    fi
    # The exit code names which half is up: 0 both, 1 container only (the
    # headless-node state), 2 session only (cannot outlive its container),
    # 3 neither.
    if [ "$c" -eq 0 ] && [ "$s" -eq 0 ]; then
      exit 0
    fi
    if [ "$c" -eq 0 ]; then
      exit 1
    fi
    if [ "$s" -eq 0 ]; then
      exit 2
    fi
    exit 3
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|session-start|session-stop|session-status}" >&2
    exit 2
    ;;
esac

exit 0
