#!/bin/sh
### BEGIN INIT INFO
# Provides:          supermox-corosync
# Required-Start:    $network $remote_fs supermox-hosts
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# X-Start-Before:    corosync pve-cluster
# Short-Description: Write this node's single-node corosync.conf before corosync starts
### END INIT INFO

# pmxcfs (pve-cluster) runs in normal corosync mode: it resolves `hostname`
# to a non-loopback IP and needs a matching nodelist entry in
# /etc/corosync/corosync.conf. The corosync package ships a placeholder
# (name: node1) that cannot work for a single node, and a node's hostname and
# DHCP address differ from the machine an image was built on, so the file
# has to be written on every boot, not once at install time.
#
# pve-cluster's postinst used to write it (patches/pve-cluster/0005 + 0007).
# Inside a live-build/mmdebstrap chroot that baked the BUILD machine's identity
# into the image: the PC ISO booted with
#   corosync: failed to parse bindnet address 'localhost.localdomain'
#   Corosync Cluster Engine exiting with status 8 at main.c:1428.
# and /etc/pve stayed read-only, so every later service failed. Patch 0011
# makes the postinst skip build chroots and this script owns the file at boot.
#
# The file is deliberately NOT a conffile of supermox-ve: the corosync package
# already ships /etc/corosync/corosync.conf as its own conffile, and two packages
# claiming one path is a hard install-time file conflict. Rewriting it every boot
# needs no dpkg involvement at all.
#
# It writes the file when it is missing, when it is still the corosync
# package placeholder, or when it carries our own header
#   # generated by pve-cluster for single-node SuperMox
# but names a different host or IP (the hostname changed, DHCP moved).
# Any other file -- a real multi-node cluster config -- is never touched.
# The content is byte-for-byte what 0007 wrote, from the current `hostname`
# and its first non-loopback address (the same IP filter as 0005).
#
# CONF_FILE is overridable so the offline test can point the script at a scratch
# corosync.conf under build/; `hostname` is stubbed through PATH.
# The file is written atomically (temp file + mv) with mode 0644.
#
# No usable address is a warning, never a boot failure: `start` exits 0 so
# the rest of the boot continues (supermox-hosts, which this script requires,
# has already waited for DHCP).

. /lib/lsb/init-functions

NAME=supermox-corosync
CONF_FILE=${CONF_FILE:-/etc/corosync/corosync.conf}
OUR_HEADER='# generated by pve-cluster for single-node SuperMox'
# The first line of a cluster config written by supermox-join
# (src/supermox/corosync_cluster.py: MANAGED_MARKER). Compared as a fixed
# substring, so the wording of that line only has to match in substance;
# if you reword it, reword this too.
MANAGED_MARKER='managed by supermox-join'

# The short hostname pmxcfs looks up.
node_hn() {
  hostname 2>/dev/null | awk '{print $1; exit}'
}

# The node's first non-loopback address: exactly the filter pve-cluster's
# postinst used (`hostname -I` minus loopback, link-local and unspecified
# addresses). Empty lines are dropped so a trailing space cannot win head.
node_ip() {
  hostname -I 2>/dev/null | tr ' ' '\n' \
    | grep -vE '^(127\.|::1|fe80:|fec0:|fd[0-9]|0:)' \
    | grep -vE '^$' | head -n 1
}

is_loopback() {
  case "$1" in
    127.* | ::1 | 0:0:0:0) return 0 ;;
    *) return 1 ;;
  esac
}

# What the config is: missing, placeholder (the corosync package's own
# example, which names node1), ours (carries our header), managed (a real
# cluster config written by supermox-join) or foreign (a real cluster
# config, written by an admin or by pvecm).
classify() {
  f=$1
  [ -f "$f" ] || {
    printf 'missing\n'
    return 0
  }
  # Checked before the placeholder test on purpose: a cluster config
  # supermox-join wrote names nodes the operator chose, and an operator is
  # free to call one of them node1. Falling through to 'placeholder' would
  # make this script rewrite that file at the next boot -- and node_ip
  # filters every fdXX: ULA out, so the rewrite would put the management
  # address into a cluster nodelist and take this node off the overlay.
  if grep -qF "$MANAGED_MARKER" "$f"; then
    printf 'managed\n'
    return 0
  fi
  if grep -q 'name: node1' "$f"; then
    printf 'placeholder\n'
    return 0
  fi
  if grep -qF "$OUR_HEADER" "$f"; then
    printf 'ours\n'
    return 0
  fi
  printf 'foreign\n'
  return 0
}

# The nodelist as (name, ring0_addr) pairs, in file order. Both keys may
# come first in a node block, so a pair is emitted once both are seen.
conf_pairs() {
  f=$1
  awk '
    {
      for (i = 1; i < NF; i++) {
        if ($i == "name:") nm = $(i + 1)
        if ($i == "ring0_addr:") ra = $(i + 1)
      }
      if (nm != "" && ra != "") { print nm, ra; nm = ""; ra = "" }
    }' "$f"
}

# The address the nodelist gives node <hn> (empty when it does not name it).
conf_addr() {
  conf_pairs "$1" | awk -v hn="$2" '$1 == hn { print $2; exit }'
}

# Write the single-node config for host <hn> at address <ip>: the same
# content pve-cluster's postinst writes, so both writers recognise each
# other's output. Temp file in the same directory, then mv.
write_conf() {
  hn=$1
  ip=$2
  dir=${CONF_FILE%/*}
  [ -n "$dir" ] || dir=.
  mkdir -p "$dir" || return 1
  tmp="$CONF_FILE.supermox-tmp"
  if [ -e "$CONF_FILE" ] && [ ! -w "$CONF_FILE" ]; then
    printf '%s: %s is not writable\n' "$NAME" "$CONF_FILE" >&2
    return 1
  fi
  cat > "$tmp" <<EOF
$OUR_HEADER
logging {
    to_syslog: yes
}
nodelist {
    node {
        name: $hn
        nodeid: 1
        quorum_votes: 1
        ring0_addr: $ip
    }
}
quorum {
    provider: corosync_votequorum
}
totem {
    cluster_name: supermox
    config_version: 1
    interface {
        bindnetaddr: $ip
        ringnumber: 0
    }
    ip_version: ipv4
    secauth: off
    version: 2
}
EOF
  chmod 0644 "$tmp"
  mv -f "$tmp" "$CONF_FILE"
}

case "${1:-}" in
  start)
    hn=$(node_hn)
    if [ -z "$hn" ]; then
      log_warning_msg "$NAME: no hostname, $CONF_FILE not written"
      exit 0
    fi
    kind=$(classify "$CONF_FILE")
    if [ "$kind" = managed ]; then
      # A cluster config supermox-join wrote: the nodelist is the cluster's
      # membership on its WireGuard overlay, and this generator cannot
      # reproduce it (see node_ip, which drops every fdXX: address), so
      # the file is left byte-for-byte as supermox-join wrote it.
      log_begin_msg "$NAME: $CONF_FILE is a cluster config managed by supermox-join, leaving it alone"
      log_end_msg 0
      exit 0
    fi
    if [ "$kind" = foreign ]; then
      # A real (multi-node) cluster config: this node's name and address
      # are the admin's or pvecm's business, never ours.
      log_begin_msg "$NAME: $CONF_FILE is a cluster config, leaving it alone"
      log_end_msg 0
      exit 0
    fi
    ip=$(node_ip)
    if [ -z "$ip" ]; then
      log_warning_msg "$NAME: no non-loopback IP for '$hn', $CONF_FILE not written"
      exit 0
    fi
    if [ "$kind" = ours ] && [ "$(conf_addr "$CONF_FILE" "$hn")" = "$ip" ]; then
      log_begin_msg "$NAME: $CONF_FILE already names $hn at $ip"
      log_end_msg 0
      exit 0
    fi
    if ! write_conf "$hn" "$ip"; then
      log_begin_msg "$NAME: cannot write $CONF_FILE"
      log_end_msg 1
      exit 1
    fi
    log_begin_msg "$NAME: wrote single-node $CONF_FILE ($hn at $ip)"
    log_end_msg 0
    exit 0
    ;;
  stop)
    # The config is boot-time state, not a service: deleting it would only
    # break corosync and pmxcfs until the next boot. Deliberately a no-op.
    exit 0
    ;;
  restart)
    "$0" start
    ;;
  status)
    hn=$(node_hn)
    [ -n "$hn" ] || exit 3
    kind=$(classify "$CONF_FILE")
    if [ "$kind" = missing ] || [ "$kind" = placeholder ]; then
      printf '%s: %s does not name this node\n' "$NAME" "$CONF_FILE" >&2
      exit 3
    fi
    # A managed config is checked like a foreign one: what matters is that
    # it maps this node's name to a non-loopback address, and an fdXX:
    # ULA is a legitimate address for a cluster node on the overlay.
    ip=$(conf_addr "$CONF_FILE" "$hn")
    if [ -z "$ip" ] || is_loopback "$ip"; then
      printf '%s: %s does not map %s to a non-loopback address\n' \
        "$NAME" "$CONF_FILE" "$hn" >&2
      exit 3
    fi
    printf '%s: %s names %s at %s\n' "$NAME" "$CONF_FILE" "$hn" "$ip"
    exit 0
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 2
    ;;
esac

exit 0
